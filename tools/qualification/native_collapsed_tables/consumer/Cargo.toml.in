[package]
name = "openui-native-collapsed-table"
version = "0.1.0"
edition = "2021"
rust-version = "1.85"

[dependencies]
openui = { version = "=0.2.0", path = "@OPENUI_ROOT@/bindings/rust/openui" }
openui-text = { version = "=0.2.0", path = "@OPENUI_ROOT@/bindings/rust/openui-text" }
serde_json = "1.0"

[patch.crates-io]
skia-safe = { git = "https://github.com/rust-skia/rust-skia.git", rev = "a31b86ba3b767344d39af3b8c30043003d8fc991" }
skia-bindings = { git = "https://github.com/rust-skia/rust-skia.git", rev = "a31b86ba3b767344d39af3b8c30043003d8fc991" }
skrifa = { path = "@OPENUI_ROOT@/bindings/rust/vendor/skrifa-v0_40" }
read-fonts = { path = "@OPENUI_ROOT@/bindings/rust/vendor/read-fonts-v0_37" }
font-types = { path = "@OPENUI_ROOT@/bindings/rust/vendor/font-types-v0_11" }
bytemuck = { path = "@OPENUI_ROOT@/bindings/rust/vendor/bytemuck-v1" }
bytemuck_derive = { path = "@OPENUI_ROOT@/bindings/rust/vendor/bytemuck_derive-v1" }
