  "wpt/css_overflow/line-clamp_line-clamp-auto-001-crash": "<div class=\"clamp\">\n  Line 1\n  <div>\n    <div></div>\n  </div>\n  Line 2\n</div>",
  "wpt/css_overflow/line-clamp_line-clamp-auto-002-crash": "<div class=\"parent\">\n  <div class=\"margins\">A</div>\n  <div>\n    <div class=\"float\"></div>\n    B\n  </div>\n</div>",
  "wpt/css_overflow/line-clamp_line-clamp-auto-039": "<div class=\"clamp\">\nLine 1<br>\nLine 2<br>\nLine 3<br>\nLine 4<br>\n<div></div>\nLine 5\n</div>",
  "wpt/css_overflow/line-clamp_line-clamp-auto-040": "<div class=\"clamp\">\nLine 1<br>\nLine 2<br>\nLine 3<br>\nLine 4<br>\n<div class=zero>\nLine 5<br>\nLine 6\n</div>\nLine 7\n</div>",
  "wpt/css_overflow/line-clamp_line-clamp-auto-043": "<div class=\"clamp\">\n  <div class=\"max-height\">\n    Line 1 <br>\n    Line 2 <br>\n    Line 3\n  </div>\n  Line B <br>\n  Line C\n</div>",
  "wpt/css_overflow/line-clamp_line-clamp-auto-044": "<div class=\"clamp\">\n  <div style=\"max-height: 3.5lh\">\n    <p>Line 1</p>\n    <p>Line 2</p>\n    <!-- If we weren't inside a max-height box, we'd clamp here -->\n    <div style=\"min-height: 3lh\">Line 3</div>\n    <p>Line 4</p>\n  </div>\n  <!-- We actually clamp here, even if the line with the ellipsis has its bottom\n       edge at a height offset of 6lh, clearly overflowing .clamp -->\n  <p>Line 5</p>\n</div>",
  "wpt/css_overflow/line-clamp_line-clamp-auto-045": "<div class=\"clamp\">\n  Line 1<br>\n  Line 2<br>\n  Line 3<br>\n  <div class=\"float\">\n    Line A <br>\n    Line B\n  </div>\n  Line 4<br>\n  <div class=\"margin\">\n    <div class=\"margin\" style=\"min-height: 0.5lh\">\n      <div class=\"margin\" style=\"clear: right;\">\n        <div class=\"abspos\">Abspos</div>\n      </div>\n      Line 5\n    </div>\n  </div>\n  Line 6 <br>\n  Line 7\n</div>",
  "wpt/css_overflow/line-clamp_line-clamp-auto-046": "<div class=\"clamp\">\n  <div class=\"size-containment\">\n    Line A <br>\n    Line B <br>\n    Line C <br>\n    Line D <br>\n    Line E <br>\n  </div>\n  Line 1 <br>\n  Line 2 <br>\n  Line 3 <br>\n  Line 4 <br>\n  Line 5 <br>\n</div>",
  "wpt/css_overflow/line-clamp_line-clamp-auto-047": "<div class=\"clamp\">\n  <div class=\"size-containment\">\n    Line A <br>\n    Line B <br>\n    Line C <br>\n    Line D <br>\n    Line E <br>\n  </div>\n  Line 1 <br>\n  Line 2\n  <div class=\"size-containment\">\n    Line A <br>\n    Line B <br>\n    Line C <br>\n    Line D <br>\n    Line E <br>\n  </div>\n  Line 3\n</div>",
  "wpt/css_overflow/scroll-markers_column-scroll-marker-counters-ref": "<div id=\"scroller\">\n  <div class=\"item\">1</div>\n  <div class=\"item\">2</div>\n  <div class=\"item\">3</div>\n</div>\n<div id=\"scroll-marker-group\">\n  <div class=\"scroll-marker\"><a href=\"#\">1</a></div>\n  <div class=\"scroll-marker\"><a href=\"#\">2</a></div>\n  <div class=\"scroll-marker\"><a href=\"#\">3</a></div>\n</div>",
