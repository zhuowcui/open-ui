{
  "wpt/css_overflow/clip-001-ref": "<div id=\"container\">\n  <div id=\"target\">\n    <div id=\"fill\"></div>\n  </div>\n</div>",
  "wpt/css_overflow/clip-001": "<div id=\"container\">\n  <div id=\"target\">\n    <div id=\"fill\"></div>\n  </div>\n</div>",
  "wpt/css_overflow/clip-002-ref": "<!-- there should be no overflow -->\n<div class=\"outer\">\n  <div class=\"inner\" style=\"width:50px; height:50px;\"></div>\n</div>\n\n<!-- there should be overflow in the vertical dimension, but not horizontally -->\n<div class=\"outer\">\n  <div class=\"inner\" style=\"top:-20px; width:50px\"></div>\n</div>\n\n<!-- there should be overflow in the horizontal dimension, but not vertically -->\n<div class=\"outer\">\n  <div class=\"inner\" style=\"left:-40px; height:50px\"></div>\n</div>",
  "wpt/css_overflow/clip-002": "<!-- there should be no overflow -->\n<div class=\"outer\" style=\"overflow:clip\">\n  <div class=\"inner\"></div>\n</div>\n\n<!-- there should be overflow in the vertical dimension, but not horizontally -->\n<div class=\"outer\" style=\"overflow-x:clip\">\n  <div class=\"inner\"></div>\n</div>\n\n<!-- there should be overflow in the horizontal dimension, but not vertically -->\n<div class=\"outer\" style=\"overflow-y:clip\">\n  <div class=\"inner\"></div>\n</div>",
  "wpt/css_overflow/clip-004-ref": "<!-- there should be no overflow -->\n<div class=\"outer\">\n  <div class=\"inner\" style=\"width:50px; height:50px;\"></div>\n</div>\n\n<!-- there should be overflow in the vertical dimension, but not horizontally -->\n<div class=\"outer\">\n  <div class=\"inner\" style=\"top:-10px; width:50px\"></div>\n</div>\n\n<!-- there should be overflow in the horizontal dimension, but not vertically -->\n<div class=\"outer\">\n  <div class=\"inner\" style=\"left:-30px; height:50px\"></div>\n</div>",
  "wpt/css_overflow/clip-004": "<!-- there should be no overflow -->\n<div class=\"outer\" style=\"overflow:clip\">\n  <div class=\"inner\"></div>\n</div>\n\n<!-- there should be overflow in the vertical dimension, but not horizontally -->\n<div class=\"outer\" style=\"overflow-x:clip\">\n  <div class=\"inner\"></div>\n</div>\n\n<!-- there should be overflow in the horizontal dimension, but not vertically -->\n<div class=\"outer\" style=\"overflow-y:clip\">\n  <div class=\"inner\"></div>\n</div>",
  "wpt/css_overflow/clip-006": "<div style=\"width: 100px; height: 100px; overflow-x: auto;\">\n  <div style=\"overflow-x: clip;\">\n    <div style=\"width: 200px; height: 100px; background: green;\"></div>\n  </div>\n</div>",
  "wpt/css_overflow/clip-007": "<div style=\"width: 100px; height: 100px; overflow-y: auto;\">\n  <div style=\"overflow-y: clip; height: 100px;\">\n    <div style=\"width: 100px; height: 200px; background: green;\"></div>\n  </div>\n</div>",
  "wpt/css_overflow/clip-008": "<div id=\"testHolder\">\n  <div id=\"clipped\">\n    <div id=\"contents\"></div>\n  </div>\n</div>",
  "wpt/css_overflow/display-flex-svg-overflow-default-ref": "<div></div>",
