  "wpt/css_overflow/rounded-overflow-clip-visible-ref": "There should be 4 100x100 green squares (no rounded corners) below.<br>\n<div class=\"box\"></div>\n<div class=\"box\"></div>\n<div class=\"box\"></div>\n<div class=\"box\"></div>",
  "wpt/css_overflow/rounded-overflow-visible-clip-ref": "There should be 4 100x100 green squares (no rounded corners) below.<br>\n<div class=\"box\"></div>\n<br>\n<div class=\"box\"></div>\n<br>\n<div class=\"box\"></div>\n<br>\n<div class=\"box\"></div>",
