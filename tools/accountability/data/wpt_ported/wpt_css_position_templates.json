{
  "wpt/css_position/absolute-pos-box-inside-fixed-pos-box-with-changing-height-ref": "<style>\n.box {\n  position: absolute;\n  top: 250px;\n  left: 0px;\n  width: 50px;\n  height: 50px;\n  background: green;\n}\n</style>\n<div class=\"box\"></div>",
  "wpt/css_position/block-axis-constraint-changes-for-out-of-flow-box-ref": "<style>\n.long {\n  width: 200px;\n  height: 50px;\n  background-color: blue;\n}\n.short {\n  width: 50px;\n  height: 50px;\n  background-color: green;\n}\n</style>\n<div class=\"long\"></div><div class=\"short\"></div><div class=\"short\"></div><div class=\"long\"></div>",
  "wpt/css_position/containing-block-change-scrollframe-ref": "<style>\n  #container {\n    width: 400px;\n    height: 400px;\n    margin: 100px;\n    background-color: purple;\n    position: relative;\n  }\n  #spacer {\n    height: 300px;\n  }\n  #bottom {\n    height: 100px;\n    background-color: green;\n  }\n  #abspos {\n    position: absolute;\n    width: 100px;\n    height: 100px;\n    background-color: green;\n    top: 0;\n    left: 0;\n  }\n</style>\n<div id=\"container\"><div id=\"spacer\"></div><div id=\"bottom\"></div><div id=\"abspos\"></div></div>",
  "wpt/css_position/hypothetical-dynamic-change-001-ref": "<style>\n  .ancestor {\n    width: 100px;\n    height: 100px;\n    position: fixed;\n    left: 100px;\n    top: 0;\n    background-color: green;\n  }\n</style>\n<div class=\"ancestor\"></div>",
  "wpt/css_position/position-absolute-center-001": "<style>\n#containing-block {\n  position: relative;\n  width: 100px;\n  height: 100px;\n  background: red;\n  display: flex;\n}\n\n#containing-block > div {\n  flex-grow: 1;\n}\n\n#inner-flex {\n  display: flex;\n  justify-content: center;\n}\n\nspan {\n  display: inline-block;\n  inline-size: 50px;\n  block-size: 10px;\n}\n</style>\n<div id=\"containing-block\" style=\"flex-direction: row;\"><div id=\"inner-flex\" style=\"margin: 10px; height: 100px;\"><div style=\"position: absolute; top: 0; height: 100px; background: green;\"><span></span><span></span></div></div><div style=\"height: 100px; background: green;\"></div></div>",
  "wpt/css_position/position-absolute-center-003": "<style>\n.s100 {\n  width: 100px;\n  height: 100px;\n  box-sizing: border-box;\n}\n</style>\n<div class=\"s100\" style=\"position: relative;\"><div class=\"s100\" style=\"position: absolute; background: red; border: solid green; border-width: 30px 20px 20px 30px;\"></div><div class=\"s100\" style=\"display: flex; align-items: center; justify-content: center;\"><div style=\"position: absolute; width: 50px; height: 50px; margin-left: 10px; margin-top: 10px; background: green;\"></div></div></div>",
  "wpt/css_position/position-absolute-center-004": "<style>\n.s100 {\n  width: 100px;\n  height: 100px;\n  box-sizing: border-box;\n}\n</style>\n<div class=\"s100\" style=\"position: relative;\"><div class=\"s100\" style=\"position: absolute; background: red; border: solid green; border-width: 20px 30px 30px 20px;\"></div><div class=\"s100\" style=\"display: flex; align-items: center; justify-content: center;\"><div style=\"position: absolute; width: 50px; height: 50px; margin-right: 10px; margin-bottom: 10px; background: green;\"></div></div></div>",
  "wpt/css_position/position-absolute-fit-content": "<div style=\"position: relative; width: 100px; height: 200px;\"><div style=\"position: absolute; top: 0; bottom: 0; left: 0; right: 0; max-height: fit-content; background: green;\"><div style=\"height: 100px;\"></div></div></div>",
  "wpt/css_position/position-absolute-iframe-print-ref": "<style>\n  body { margin: 0 }\n</style>\n<div style=\"position:absolute; top:0; left:0;\"></div><div style=\"height:200vh;\"></div>",
  "wpt/css_position/position-absolute-in-inline-003": "<style>\n  #container {\n    font: 20px/1 Ahem;\n    color: white;\n  }\n  .abs {\n    position: absolute;\n    background-color: green;\n    height: 100px;\n    width: 100px;\n    top: -60px;\n  }\n</style>\n<div id=\"container\" style=\"height: 100px; width: 100px; background-color: red;\"><div style=\"height: 60px;\"></div><span style=\"position: relative;\"><div></div><div class=\"abs\"></div></span></div>",
  "wpt/css_position/position-absolute-in-inline-004": "<style>\n  #container {\n    height: 100px;\n    width: 100px;\n    font: 20px/1 Ahem;\n    color: white;\n    background-color: red;\n  }\n  .abs {\n    position: absolute;\n    background-color: green;\n    height: 100px;\n    width: 50px;\n    top: -50px;\n  }\n</style>\n<div id=\"container\"><div style=\"height: 50px;\"></div><span style=\"position: relative;\"><div class=\"abs\" style=\"left: -30px;\"></div><div class=\"abs\" style=\"left: -80px;\"></div></span></div>",
  "wpt/css_position/position-absolute-large-negative-inset-ref": "<style>\n  div {\n    background:green;\n    width:50px;\n    height:50px;\n  }\n</style>\n<div></div>",
  "wpt/css_position/position-absolute-multicol-001": "<div style=\"position: relative;\"><div style=\"position: absolute;\"></div><div style=\"column-count: 2;\"><div style=\"position: absolute;\"></div></div></div>",
  "wpt/css_position/position-change-ref": "<div style=\"position: relative; background: red; width: 100px; height: 100px; overflow: hidden;\"><div style=\"overflow-y: scroll; width: 400px; height: 400px;\"><div style=\"height: 100px; width: 100px; background: green;\"></div><div style=\"height: 700px;\"></div></div></div>",
  "wpt/css_position/position-fixed-dynamic-transformed-sibling-ref": "<style>\n  body {\n    margin: 0;\n  }\n  .fixed {\n    position: fixed;\n    top: 0;\n    left: 0;\n    width: 100%;\n    height: 50px;\n    background-color: blue;\n  }\n</style>\n<div class=\"fixed\"></div>",
  "wpt/css_position/position-fixed-overflow-print-ref": "<style>\n  :root {\n    print-color-adjust: exact;\n  }\n  body { margin: 0 }\n\n  #outer, #inner {\n    background-color: purple;\n    width: 50%;\n    height: 100vh;\n  }\n\n  #inner {\n    position: absolute;\n    background-color: blue;\n    top: 0;\n    left: 50%;\n  }\n</style>\n<div id=\"outer\"><div id=\"inner\"></div></div>",
  "wpt/css_position/position-fixed-overflow-print": "<style>\n  :root {\n    print-color-adjust: exact;\n  }\n  body { margin: 0 }\n\n  #outer, #inner {\n    background-color: purple;\n    width: 100vw;\n    height: 100vh;\n  }\n\n  #inner {\n    position: fixed;\n    background-color: blue;\n    top: 0;\n    left: 50%;\n  }\n</style>\n<div id=\"outer\"><div id=\"inner\"></div></div>",
  "wpt/css_position/position-fixed-scroll-nested-fixed-ref": "<div style=\"width: 200px; height: 100px; background: green\"></div><div style=\"height: 4900px\"></div>",
  "wpt/css_position/position-fixed-scroll-overlap-ref": "<div style=\"width: 100px; height: 8000px; background: green\"></div>",
  "wpt/css_position/position-relative-001": "<div style=\"width: 100px; height: 100px; background: red;\"><span style=\"position: relative; top: 100%; left: 100%;\"><div style=\"width: 100px; height: 100px; background: green; position: relative; top: -100px; left: -100px;\"></div></span></div>",
  "wpt/css_position/position-relative-002": "<div style=\"width: 100px; height: 100px; background: red;\"><span style=\"position: relative; top: 100px; left: 100px;\"><div style=\"width: 100px; height: 100px; background: green; position: relative; top: -100%; left: -100%;\"></div></span></div>",
  "wpt/css_position/position-relative-003": "<div style=\"width: 100px; height: 100px; background: red;\"><span style=\"position: relative; top: 100%; left: 100%;\"><span style=\"position: relative; top: -100px; left: -100px;\"><div style=\"width: 100px; height: 100px; background: green; position: fixed;\"></div></span></span></div>",
  "wpt/css_position/position-relative-006": "<div style=\"width: 100px; min-height: 100px; background: red;\"><div style=\"width: 100px; height: 100px; background: green; top: -10000%; position: relative;\"></div></div>",
  "wpt/css_position/position-relative-007": "<div style=\"width: 100px; min-height: 100px; background: red;\"><div style=\"width: 100px; height: 100px; background: green; top: calc(10px + 10%); position: relative;\"></div></div>",
  "wpt/css_position/static-position_htb-ref": "<style>\n.container {\n  background: green;\n  height: 16px;\n  border: solid black 3px;\n  width: 400px;\n  margin: 16px 0;\n}\n\n.large { height: 32px; }\n</style>\n<div class=\"container\"></div><div class=\"container\"></div><div class=\"container large\"></div><div class=\"container large\"></div><div class=\"container\"></div><div class=\"container\"></div><div class=\"container large\"></div><div class=\"container large\"></div><div class=\"container\"></div><div class=\"container\"></div><div class=\"container large\"></div><div class=\"container large\"></div>",
  "wpt/css_position/static-position_inline-level-absolute-in-block-level-context-013": "<div style=\"overflow: hidden;\"><div style=\"float: left; width: 100px; height: 50px; background: green;\"></div><div style=\"clear: both; width: 100px; height: 50px; background: red;\"><div style=\"position: absolute; display: inline; width: 100px; height: 50px; background: green;\"></div></div></div>",
  "wpt/css_position/static-position_inline-level-absolute-in-block-level-context-014": "<div style=\"overflow: hidden;\"><div style=\"float: left; width: 100px; height: 50px; background: green;\"></div><div style=\"clear: both; width: 100px; height: 50px; background: red;\"><div></div><div style=\"position: absolute; display: inline; width: 100px; height: 50px; background: green;\"></div></div></div>",
  "wpt/css_position/sticky_position-sticky-bottom-004": "<style>\n#scroll-container {\n  overflow: hidden;\n  width: 100px;\n  height: 100px;\n  background: red;\n}\n#sticky {\n  position: sticky;\n  bottom: 0;\n  height: 100px;\n  background: green;\n}\n</style>\n<div id=\"scroll-container\"><div style=\"height: 100px; margin-top: -100px\"><div style=\"height: 100px\"></div><div id=\"sticky\"></div></div></div>",
  "wpt/css_position/sticky_position-sticky-bottom-005": "<style>\n#scroll-container {\n  overflow: hidden;\n  width: 100px;\n  height: 100px;\n  background: red;\n}\n#sticky {\n  position: sticky;\n  bottom: 0;\n  height: 100px;\n  background: green;\n}\n</style>\n<div id=\"scroll-container\"><div style=\"padding-top: 200px\"><div style=\"margin-top: -200px\"></div><div id=\"sticky\"></div></div></div>",
  "wpt/css_position/sticky_position-sticky-bottom-006": "<style>\n#scroll-container {\n  overflow: hidden;\n  width: 100px;\n  height: 100px;\n  background: green;\n}\n#sticky {\n  position: sticky;\n  bottom: 0;\n  height: 100px;\n  background: red;\n}\n</style>\n<div id=\"scroll-container\"><div style=\"margin-top: -100px\"></div><div id=\"sticky\"></div></div>",
  "wpt/css_position/sticky_position-sticky-change-top-ref": "<style>\n.box {\n  /* Triggers promotion without creating stacking context. */\n  backface-visibility: hidden;\n  background: green;\n  position: sticky;\n  top: 200px;\n  width: 100px;\n  height: 100px;\n}\n\n.spacer {\n  height: 200vh;\n}\n</style>\n<div class=\"box\"></div><div class=\"spacer\"></div>",
  "wpt/css_position/sticky_position-sticky-column-reverse-flex-ref": "<div style=\"scrollbar-width: none; position: relative; display: flex; flex-direction: column-reverse; overflow-y: scroll; width: 100px; height: 100px;\"><div style=\"position: absolute; bottom: 0; height: 50px; width: 50px; background: green\"></div><div style=\"min-height: 400px;\"></div></div>",
  "wpt/css_position/sticky_position-sticky-escape-scroller-001-ref": "<div style=\"width: 200px; height: 200px; background: green\"></div>",
  "wpt/css_position/sticky_position-sticky-fixed-ancestor-003": "<style>\n  html, body, div\n    {\n      height: 100%;\n      margin: 0;\n      width: 100%;\n    }\n\n  div#fixed-container\n    {\n      background-color: red;\n      color: yellow;\n      font-size: 40vh;\n      position: fixed;\n    }\n\n  div#sticky\n    {\n      background-color: green;\n      bottom: 0;\n      color: white;\n      position: sticky;\n    }\n  </style>\n<div id=\"fixed-container\"><div id=\"vertical-spacer\"></div><div id=\"sticky\"></div></div>",
  "wpt/css_position/sticky_position-sticky-margins-002": "<style>\n#container{\n  width: 100px;\n  height: 100px;\n  overflow: hidden;\n  background: red;\n}\n.flex {\n  display: flex;\n  flex-direction: column;\n  height: 500px;\n}\n.child {\n  width: 100px;\n  height: 100px;\n  background: green;\n  position: sticky;\n  margin-top: auto;\n  bottom: 0;\n}\n</style>\n<div id=\"container\"><div class=\"flex\"><div class=\"child\"></div></div></div>",
  "wpt/css_position/sticky_position-sticky-margins-003": "<style>\n#container{\n  width: 100px;\n  height: 100px;\n  overflow: hidden;\n  background: red;\n}\n.block {\n  width: 500px;\n}\n.child {\n  width: 100px;\n  height: 100px;\n  background: green;\n  position: sticky;\n  margin-left: auto;\n  right: 0;\n}\n</style>\n<div id=\"container\"><div class=\"block\"><div class=\"child\"></div></div>",
  "wpt/css_position/sticky_position-sticky-padding-001-ref": "<style>\n  .block {\n    position: relative;\n    width: 300px;\n    height: 210px;\n    padding: 10px;\n    padding-top: 0;\n    margin: 10px;\n    float: left;\n    background-color: #ddd;\n  }\n\n  .col {\n    width: 100px;\n    background-color: blue;\n    height: 210px;\n  }\n\n  .abspos {\n    position: absolute;\n    width: 10px;\n    height: 10px;\n    background-color: cyan;\n    top: 210px;\n  }\n</style>\n<div class=\"block\"><div class=\"col\"></div><div class=\"abspos\"></div></div><div class=\"block\"><div class=\"col\"></div><div class=\"abspos\"></div></div>",
  "wpt/css_position/sticky_position-sticky-padding-002-ref": "<style>\n  .block {\n    position: relative;\n    width: 210px;\n    height: 300px;\n    padding: 10px;\n    padding-left: 0;\n    margin: 10px;\n    float: left;\n    background-color: #ddd;\n  }\n\n  .row {\n    height: 100px;\n    width: 210px;\n    background-color: blue;\n  }\n\n  .abspos {\n    position: absolute;\n    width: 10px;\n    height: 10px;\n    background-color: cyan;\n    top: 0;\n    left: 210px;\n  }\n</style>\n<div class=\"block\"><div class=\"row\"></div><div class=\"abspos\"></div></div><div class=\"block\"><div class=\"row\"></div><div class=\"abspos\"></div></div>",
  "wpt/css_position/sticky_position-sticky-rtl-ref": "<style>\n.container {\n  display: flex;\n  overflow: auto;\n  width: 500px;\n  position: relative;\n}\n\n.container {\n  scrollbar-width: none;\n}\n\n.child {\n  width: 1900px;\n  height: 100px;\n  flex-shrink: 0;\n  background: lightblue;\n}\n.sticky {\n  position: absolute;\n  left: 0;\n  width: 100px;\n  height: 100px;\n  flex-shrink: 0;\n  background: lightgreen;\n}\n</style>\n<div class=\"container\" dir=\"rtl\"><div class=\"child\"></div><div class=\"sticky\"></div></div>",
  "wpt/css_position/sticky_position-sticky-rtl": "<style>\n.container {\n  display: flex;\n  overflow: auto;\n  width: 500px;\n  position: relative;\n}\n\n.container {\n  scrollbar-width: none;\n}\n\n.child {\n  width: 1900px;\n  height: 100px;\n  flex-shrink: 0;\n  background: lightblue;\n}\n.sticky {\n  position: sticky;\n  left: 0;\n  width: 100px;\n  height: 100px;\n  flex-shrink: 0;\n  background: lightgreen;\n}\n</style>\n<div class=\"container\" dir=\"rtl\"><div class=\"child\"></div><div class=\"sticky\"></div></div>",
  "wpt/css_position/sticky_position-sticky-stacking-context-ref": "<style>\n.indicator {\n  background-color: green;\n}\n\n.box {\n  width: 200px;\n  height: 200px;\n}\n</style>\n<div></div><div class=\"indicator box\"></div>",
  "wpt/css_position/resources_position-absolute-iframe-child": "<style>\n  body { margin: 0 }\n</style>\n<div style=\"height:200vh;\"></div><div style=\"position:absolute; top:0; left:0;\"></div>"
