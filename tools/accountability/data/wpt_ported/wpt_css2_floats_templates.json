{
  "wpt/css2_floats/float-in-inline-anonymous-block-with-overflow-hidden": "<div style=\"overflow: hidden; width: 100px; height: 100px; background: red\">\n  <div style=\"height: 50px; background: green\"></div>\n  <span>\n    <div style=\"float: left; width: 100px; height: 50px; background: green\"></div>\n  </span>\n</div>",
  "wpt/css2_floats/float-in-nested-multicol-001": "<!-- Browsers do not agree on the rendering, so we just verify the rendering is *not* blank. -->\n\n\n\n\n<article>\n  <main>\n    <div>&nbsp;</div>\n    <footer style=\"float: left\">\n      <div style=\"margin-top: 1em\">ABC</div> <!-- This text should appear. -->\n    </footer>\n  </main>\n</article>",
  "wpt/css2_floats/float-no-content-beside-001-ref": "<div>Test passes if all three examples render the same:</div>\n\n<p><span></span><br>Supercalifragilisticexpialidocious</p>\n\n<br style=\"clear:both\">\n\n<p><span></span><br>Supercalifragilisticexpialidocious</p>\n\n<br style=\"clear:both\">\n\n<p><span></span><br>Supercalifragilisticexpialidocious</p>",
  "wpt/css2_floats/float-no-content-beside-001": "<div>Test passes if all three examples render the same:</div>\n\n<p><span></span>Supercalifragilisticexpialidocious</p>\n\n<br style=\"clear:both\">\n\n<p><span></span> Supercalifragilisticexpialidocious</p>\n\n<br style=\"clear:both\">\n\n<p><span></span><br>Supercalifragilisticexpialidocious</p>",
  "wpt/css2_floats/float-nowrap-5-ref": "<div>Hello Kittie",
  "wpt/css2_floats/float-root-ref": "<p>foo</p>",
  "wpt/css2_floats/float-under-flatten-under-preserve-3d": "<div style=\"transform-style: preserve-3d\">\n  <div style=\"background: red; width: 100px; height: 100px\">\n    <div style=\"float: left; background: green; width: 100px; height: 100px\"></div>\n  </div>\n</div>",
  "wpt/css2_floats/float-with-absolutely-positioned-child-with-static-inset-ref": "<div id=\"float\">\n        <div id=\"abs-child\">\n            <div id=\"abs-grandchild\"></div>\n        </div>\n    </div>",
  "wpt/css2_floats/float-with-absolutely-positioned-child-with-static-inset": "<div id=\"float\">\n        <div id=\"abs-child\">\n            <div id=\"abs-grandchild\"></div>\n        </div>\n    </div>",
  "wpt/css2_floats/floats-in-table-caption-001-ref": "<p>\nThe words floated and inline should be legible below, with inline appearing just\nto the right of the border surrounding floated.\n</p>\n\n<div style=\"float:left; border: 1px solid black;\">\n  floated\n</div>\ninline",
  "wpt/css2_floats/floats-placement-001": "<div style=\"width: 100px; height: 100px; background: red; line-height: 0; position: relative;\">\n  <div style=\"float: left; width: 20px;\"></div>\n  <div style=\"float: right; width: 30px; height: 50px; background: green;\"></div>\n  <div style=\"float: right; clear: right; width: 100px; height: 50px; background: green;\"></div>\n  <div style=\"display: inline-block; width: 50px; height: 50px; background: green;\"></div>\n  <div style=\"position: absolute; width: 20px; height: 50px; top: 0; left: 50px; background: green;\"></div>\n</div>",
  "wpt/css2_floats/floats-placement-002": "<div style=\"width: 100px; height: 100px; background: red; position: relative;\">\n  <div style=\"float: left; width: 20px;\"></div>\n  <div style=\"line-height: 0;\">\n    <div style=\"display: inline-block; width: 100px; height: 20px; background: green;\"></div>\n  </div>\n  <div style=\"float: right; width: 20px; height: 80px; background: green;\"></div>\n  <div style=\"float: right; clear: right; width: 30px; clear: right;\"></div>\n  <div style=\"display: inline-block; width: 60px; height: 60px; background: green;\"></div>\n  <div style=\"position: absolute; width: 20px; height: 80px; background: green; top: 20px; right: 20px;\"></div>\n  <div style=\"position: absolute; width: 60px; height: 20px; background: green; bottom: 0; left: 0;\"></div>\n</div>",
  "wpt/css2_floats/floats-placement-003": "<div style=\"width: 100px; height: 100px; line-height: 0; background: red; position: relative;\">\n  <div style=\"float: left; width: 20px; height: 20px;\"></div>\n  <div style=\"height: 30px; background: green;\"></div>\n  <div style=\"float: right; width: 40px; height: 20px; background: green;\"></div>\n  <div style=\"float: right; clear: right; width: 50px; height: 50px; background: green;\"></div>\n  <div style=\"float: left; width: 50px; height: 50px; background: green;\"></div>\n  <span style=\"display: inline-block; width: 40px; height: 20px; background: green;\"></span>\n  <div style=\"position: absolute; width: 20px; height: 20px; background: green; left: 40px; top: 30px;\"></div>\n</div>",
  "wpt/css2_floats/floats-placement-004": "<div style=\"width:100px; display: flow-root; background: red; line-height: 0;\">\n  <div style=\"width: 100px; height: 50px; float: left; background: green;\"></div>\n  <div style=\"width: 100px; height: 10px; float: right; background: green;\"></div>\n  <div style=\"display: inline-block; width: 100px; height: 40px; background: green;\"></div>\n</div>",
  "wpt/css2_floats/floats-placement-005-ref": "<div style=\"width: 150px; display: flow-root;\">\n  <div class=\"float-left\"></div>\n  <div style=\"height: 40px;\"></div>\n  <div class=\"float-right\"></div>\n  <div class=\"float-left\" style=\"width: 100px; height: 40px; background: cyan;\"></div>\n  <div class=\"float-right\"></div>\n  <div class=\"float-left\"></div>\n  <div class=\"float-right\"></div>\n</div>",
  "wpt/css2_floats/floats-placement-005": "<div style=\"width: 150px; display: flow-root;\">\n  <div class=\"float-left\"></div>\n  <div style=\"height: 40px;\"></div>\n  <div class=\"float-right\"></div>\n  <div class=\"float-right\"></div>\n  <div class=\"float-left\"></div>\n  <div class=\"float-right\"></div>\n  <div style=\"margin-top: 10px; line-height: 0;\"><span></span><span></span></div>\n</div>",
  "wpt/css2_floats/floats-placement-006": "<div class=\"container\">\n  <div class=\"inline-block\"></div><div class=\"float-right\"></div><div class=\"float-left\"></div>\n</div>",
  "wpt/css2_floats/floats-placement-008": "<div class=\"container\">\n  <div class=\"inline-block\"></div><div class=\"float-right\"></div><div class=\"float-left\"></div>\n  <div style=\"position: absolute; top: 50px; width: 50px; height: 50px; background-color: green\"></div>\n</div>",
  "wpt/css2_floats/floats-placement-vertical-001-ref": "<p><span class=\"left\"></span>HelloKitty\n</p><p><span class=\"right\"></span>HelloKitty\n</p><p dir=\"rtl\"><span class=\"left\"></span>HelloKitty\n</p><p dir=\"rtl\"><span class=\"right\"></span>HelloKitty\n</p><p style=\"text-align:right;\"><span class=\"left\"></span>HelloKitty\n</p><p style=\"text-align:right;\"><span class=\"right\"></span>HelloKitty\n\n\n</p>",
  "wpt/css2_floats/floats-placement-vertical-001a": "<p>Hello<span class=\"left\"></span>Kitty\n</p><p>Hello<span class=\"right\"></span>Kitty\n</p><p dir=\"rtl\">Hello<span class=\"left\"></span>Kitty\n</p><p dir=\"rtl\">Hello<span class=\"right\"></span>Kitty\n</p><p style=\"text-align:right;\">Hello<span class=\"left\"></span>Kitty\n</p><p style=\"text-align:right;\">Hello<span class=\"right\"></span>Kitty\n\n\n</p>",
  "wpt/css2_floats/floats-placement-vertical-001b": "<p><span>Hello<span class=\"left\"></span></span>Kitty\n</p><p><span>Hello<span class=\"right\"></span></span>Kitty\n</p><p dir=\"rtl\"><span>Hello<span class=\"left\"></span></span>Kitty\n</p><p dir=\"rtl\"><span>Hello<span class=\"right\"></span></span>Kitty\n</p><p style=\"text-align:right;\"><span>Hello<span class=\"left\"></span></span>Kitty\n</p><p style=\"text-align:right;\"><span>Hello<span class=\"right\"></span></span>Kitty\n\n\n</p>",
  "wpt/css2_floats/floats-placement-vertical-001c": "<p>Hello<span><span class=\"left\"></span>Kitty</span>\n</p><p>Hello<span><span class=\"right\"></span>Kitty</span>\n</p><p dir=\"rtl\">Hello<span><span class=\"left\"></span>Kitty</span>\n</p><p dir=\"rtl\">Hello<span><span class=\"right\"></span>Kitty</span>\n</p><p style=\"text-align:right;\">Hello<span><span class=\"left\"></span>Kitty</span>\n</p><p style=\"text-align:right;\">Hello<span><span class=\"right\"></span>Kitty</span>\n\n\n</p>",
  "wpt/css2_floats/floats-placement-vertical-003-ref": "<!-- Check that we don't allow floats to reorder -->\nH\n<div style=\"background:blue; width:100px; height:100px;\"></div>\n<div style=\"background:yellow; width:30px; height:30px; float:left;\"></div>\n<div style=\"background:yellow; width:30px; height:30px; float:right;\"></div>",
  "wpt/css2_floats/floats-placement-vertical-003": "<!-- Check that we don't allow floats to reorder -->\nH\n<div style=\"background:blue; width:100px; height:100px; float:left;\"></div>\n<div style=\"background:yellow; width:30px; height:30px; float:left;\"></div>\n<div style=\"background:yellow; width:30px; height:30px; float:right;\"></div>",
  "wpt/css2_floats/floats-placement-vertical-004-ref": "<div style=\"background:green; width:100px; height:100px; float:left;\"></div>\nH<br />\n<div style=\"background:blue; width:100px; height:100px; float:left;\"></div>",
  "wpt/css2_floats/floats-placement-vertical-004-ref2": "<div style=\"position:absolute; background:green; width:100px; height:100px;\"></div>\n<div style=\"position:relative; left:100px; width:100px; height:100px;\">\n  H\n  <div style=\"background:blue; width:100px; height:100px;\"></div>\n</div>",
  "wpt/css2_floats/floats-placement-vertical-004": "<!-- Check that we're actually taking inline content already in the line into account\n     when we check whether the blue float fits -->\n<div style=\"background:green; width:100px; height:100px; float:left;\"></div>\nH\n<div style=\"background:blue; width:100px; height:100px; float:left;\"></div>",
  "wpt/css2_floats/floats-rule3-outside-left-001-ref": "<div style=\"float: left; width: 500px; height: 500px\">\n  <div style=\"width: 425px; height: 10px; background: blue\"></div>\n</div>",
  "wpt/css2_floats/floats-rule3-outside-left-001": "<div style=\"float: left; width: 500px; height: 500px\">\n\n  <div style=\"float: right; width: 50px; height: 300px\"></div>\n\n  <div style=\"margin-right: 100px\"> <!-- 400px wide -->\n\n    <!-- we're testing the position of this float -->\n    <div style=\"float: left; width: 425px; height: 10px; background: blue\"></div>\n\n  </div>\n\n</div>",
  "wpt/css2_floats/floats-rule3-outside-left-002-ref": "<div style=\"float: left; width: 500px; height: 500px\">\n    <div style=\"margin-top: 300px; width: 475px; height: 10px; background: blue\"></div>\n</div>",
  "wpt/css2_floats/floats-rule3-outside-left-002": "<div style=\"float: left; width: 500px; height: 500px\">\n\n  <div style=\"float: right; width: 50px; height: 300px\"></div>\n\n  <div style=\"margin-right: 100px\"> <!-- 400px wide -->\n\n    <!-- we're testing the position of this float -->\n    <div style=\"float: left; width: 475px; height: 10px; background: blue\"></div>\n\n  </div>\n\n</div>",
  "wpt/css2_floats/floats-rule3-outside-right-001-ref": "<div style=\"float: left; width: 500px; height: 500px\">\n  <div style=\"margin-left: 75px; width: 425px; height: 10px; background: blue\"></div>\n</div>",
  "wpt/css2_floats/floats-rule3-outside-right-001": "<div style=\"float: left; width: 500px; height: 500px\">\n\n  <div style=\"float: left; width: 50px; height: 300px\"></div>\n\n  <div style=\"margin-left: 100px\"> <!-- 400px wide -->\n\n    <!-- we're testing the position of this float -->\n    <div style=\"float: right; width: 425px; height: 10px; background: blue\"></div>\n\n  </div>\n\n</div>",
  "wpt/css2_floats/floats-rule3-outside-right-002-ref": "<div style=\"float: left; width: 500px; height: 500px\">\n    <div style=\"margin-top: 300px; margin-left: 25px; width: 475px; height: 10px; background: blue\"></div>\n</div>",
  "wpt/css2_floats/floats-rule3-outside-right-002": "<div style=\"float: left; width: 500px; height: 500px\">\n\n  <div style=\"float: left; width: 50px; height: 300px\"></div>\n\n  <div style=\"margin-left: 100px\"> <!-- 400px wide -->\n\n    <!-- we're testing the position of this float -->\n    <div style=\"float: right; width: 475px; height: 10px; background: blue\"></div>\n\n  </div>\n\n</div>",
  "wpt/css2_floats/floats-rule7-outside-left-001-ref": "<div style=\"float: left; width: 500px; height: 500px\">\n    <div style=\"margin-top: 300px; margin-left: 100px; width: 425px; height: 10px; background: blue\"></div>\n</div>",
  "wpt/css2_floats/floats-rule7-outside-left-001": "<div style=\"float: left; width: 500px; height: 500px\">\n\n  <div style=\"float: left; width: 50px; height: 300px\"></div>\n\n  <div style=\"margin-left: 100px\"> <!-- 400px wide -->\n\n    <!-- we're testing the position of this float -->\n    <div style=\"float: left; width: 425px; height: 10px; background: blue\"></div>\n\n  </div>\n\n</div>",
  "wpt/css2_floats/floats-rule7-outside-right-001-ref": "<div style=\"float: left; width: 500px; height: 500px\">\n    <div style=\"margin-top: 300px; margin-left: -25px; width: 425px; height: 10px; background: blue\"></div>\n</div>",
  "wpt/css2_floats/floats-rule7-outside-right-001": "<div style=\"float: left; width: 500px; height: 500px\">\n\n  <div style=\"float: right; width: 50px; height: 300px\"></div>\n\n  <div style=\"margin-right: 100px\"> <!-- 400px wide -->\n\n    <!-- we're testing the position of this float -->\n    <div style=\"float: right; width: 425px; height: 10px; background: blue\"></div>\n\n  </div>\n\n</div>",
  "wpt/css2_floats/floats-wrap-bfc-001-left-overflow-ref": "<div style=\"width: 300px; height: 100px; background: aqua\">\n  <div style=\"float:left; background:blue; width: 100px; height: 100px\"></div>\n  <div style=\"float:left; background:yellow; width: 200px; height: 50px\">\n    <div style=\"background:purple; width: 150px; height: 50px\"></div>\n  </div>\n</div>",
  "wpt/css2_floats/floats-wrap-bfc-001-left-table-ref": "<div style=\"width: 300px; height: 100px; background: aqua\">\n  <div style=\"float:left; background:blue; width: 100px; height: 100px\"></div>\n  <div style=\"float:left; background:purple; width: 150px; height: 50px\"></div>\n</div>",
  "wpt/css2_floats/floats-wrap-bfc-001-right-overflow-ref": "<div style=\"width: 300px; height: 100px; background: aqua\">\n  <div style=\"float:right; background:blue; width: 100px; height: 100px\"></div>\n  <div style=\"float:left; background:yellow; width: 200px; height: 50px\">\n    <div style=\"background:purple; width: 150px; height: 50px\"></div>\n  </div>\n</div>",
  "wpt/css2_floats/floats-wrap-bfc-001-right-table-ref": "<div style=\"width: 300px; height: 100px; background: aqua\">\n  <div style=\"float:right; background:blue; width: 100px; height: 100px\"></div>\n  <div style=\"float:left; background:purple; width: 150px; height: 50px\"></div>\n</div>",
  "wpt/css2_floats/floats-wrap-bfc-002-left-ref": "<div style=\"width: 300px; height: 100px; background: aqua\">\n  <div style=\"float:left; background:blue; width: 100px; height: 100px\"></div>\n  <div style=\"float:left; background:yellow; width: 200px; height: 100px\">\n    <div style=\"background:purple; width: 150px; height: 100px\"></div>\n  </div>\n</div>",
  "wpt/css2_floats/floats-wrap-bfc-002-right-ref": "<div style=\"width: 300px; height: 100px; background: aqua\">\n  <div style=\"float:right; background:blue; width: 100px; height: 100px\"></div>\n  <div style=\"float:left; background:yellow; width: 200px; height: 100px\">\n    <div style=\"background:purple; width: 150px; height: 100px\"></div>\n  </div>\n</div>",
  "wpt/css2_floats/floats-wrap-bfc-003-left-overflow-ref": "<div style=\"width: 300px; height: 100px; background: aqua\">\n  <div style=\"float:left; background:blue; width: 100px; height: 100px\"></div>\n  <div style=\"float:left; background:purple; width: 200px; height: 50px\"></div>\n</div>",
  "wpt/css2_floats/floats-wrap-bfc-003-left-table-ref": "<div style=\"width: 300px; height: 150px; background: aqua\">\n  <div style=\"float:left; background:blue; width: 100px; height: 100px\"></div>\n  <div style=\"float:left; clear:left; background:purple; width: 250px; height: 50px\"></div>\n</div>",
  "wpt/css2_floats/floats-wrap-bfc-003-right-overflow-ref": "<div style=\"width: 300px; height: 100px; background: aqua\">\n  <div style=\"float:right; background:blue; width: 100px; height: 100px\"></div>\n  <div style=\"float:left; background:purple; width: 200px; height: 50px\"></div>\n</div>",
  "wpt/css2_floats/floats-wrap-bfc-003-right-table-ref": "<div style=\"width: 300px; height: 150px; background: aqua\">\n  <div style=\"float:right; background:blue; width: 100px; height: 100px\"></div>\n  <div style=\"float:left; clear:right; background:purple; width: 250px; height: 50px\"></div>\n</div>",
  "wpt/css2_floats/floats-wrap-bfc-004-ref": "<div style=\"width: 300px; height: 20px; background: aqua\">\n  <div style=\"float:left; background:blue; width: 100px; height: 20px\"></div>\n  <div style=\"float:left; background:silver; width: 100px; height: 6px\"></div>\n  <div style=\"float:left; width: 150px; height: 10px; background: purple\"></div>\n</div>\n\n<div style=\"width: 300px; height: 20px; background: aqua\">\n  <div style=\"float:left; background:blue; width: 100px; height: 20px\"></div>\n  <div style=\"float:right; background:silver; width: 100px; height: 6px\"></div>\n  <div style=\"float:left; width: 150px; height: 10px; background: purple\"></div>\n</div>\n\n<div style=\"width: 300px; height: 20px; background: aqua\">\n  <div style=\"float:right; background:blue; width: 100px; height: 20px\"></div>\n  <div style=\"float:left; background:silver; width: 100px; height: 6px\"></div>\n  <div style=\"float:left; width: 150px; height: 10px; background: purple\"></div>\n</div>\n\n<div style=\"width: 300px; height: 20px; background: aqua\">\n  <div style=\"float:right; background:blue; width: 100px; height: 20px\"></div>\n  <div style=\"float:right; background:silver; width: 100px; height: 6px\"></div>\n  <div style=\"float:left; width: 150px; height: 10px; background: purple\"></div>\n</div>\n\n<div style=\"width: 300px; height: 20px; background: aqua\">\n  <div style=\"float:left; background:blue; width: 100px; height: 20px\"></div>\n  <div style=\"float:left; background:silver; width: 100px; height: 6px\"></div>\n  <div style=\"float:left; width: 100px; height: 10px; background: purple\"></div>\n</div>\n\n<div style=\"width: 300px; height: 20px; background: aqua\">\n  <div style=\"float:left; background:blue; width: 100px; height: 20px\"></div>\n  <div style=\"float:right; background:silver; width: 100px; height: 6px\"></div>\n  <div style=\"float:left; width: 100px; height: 10px; background: purple\"></div>\n</div>\n\n<div style=\"width: 300px; height: 20px; background: aqua\">\n  <div style=\"float:right; background:blue; width: 100px; height: 20px\"></div>\n  <div style=\"float:left; background:silver; width: 100px; height: 6px\"></div>\n  <div style=\"float:left; width: 100px; height: 10px; background: purple\"></div>\n</div>\n\n<div style=\"width: 300px; height: 20px; background: aqua\">\n  <div style=\"float:right; background:blue; width: 100px; height: 20px\"></div>\n  <div style=\"float:right; background:silver; width: 100px; height: 6px\"></div>\n  <div style=\"float:left; width: 100px; height: 10px; background: purple\"></div>\n</div>",
  "wpt/css2_floats/floats-wrap-bfc-008": "<div class=\"wrapper\">\n  <div class=\"float\" style=\"width: 100px\"></div>\n  <div class=\"float\" style=\"width: 50px\"></div>\n  <div class=\"bfc\" style=\"\"></div>\n</div>",
  "wpt/css2_floats/floats-wrap-bfc-with-margin-004": "<div style=\"width:100px; height:100px; background:red;\">\n  <div style=\"display:flow-root; background:green;\">\n    <div style=\"float:right; width:50px; height:40px;\"></div>\n    <div style=\"display:flow-root; height:60px; margin-left:51px;\"></div>\n  </div>\n</div>",
  "wpt/css2_floats/floats-wrap-bfc-with-margin-006.tentative": "<div class=\"wrapper\">\n  <div class=\"float\"></div>\n  <div class=\"bfc\"></div>\n  <div class=\"float\"></div>\n  <div class=\"bfc\" style=\"width: 75px\"></div>\n</div>",
  "wpt/css2_floats/floats-wrap-bfc-with-margin-007.tentative": "<div class=\"wrapper\">\n  <div class=\"float\"></div>\n  <div class=\"bfc\"></div>\n  <div class=\"float\"></div>\n  <div class=\"bfc\" style=\"width: 75px\"></div>\n</div>",
  "wpt/css2_floats/floats-wrap-bfc-with-margin-008.tentative": "<div class=\"wrapper\">\n  <div class=\"float\"></div>\n  <div style=\"margin-right: 50px\">\n    <div class=\"bfc\"></div>\n  </div>\n</div>",
  "wpt/css2_floats/floats-wrap-bfc-with-margin-009.tentative": "<div class=\"wrapper\">\n  <div class=\"float\"></div>\n  <div style=\"margin-left: 50px\">\n    <div class=\"bfc\"></div>\n  </div>\n</div>",
  "wpt/css2_floats/floats-wrap-bfc-with-margin-010-ref": "<div class=\"wrapper\" style=\"left: 10px; height: 50px\">\n  <div class=\"float\"></div>\n  <div class=\"bfc\" style=\"width: 50px; left: 0; top: -75px\"></div>\n</div>\n<div class=\"wrapper\" style=\"left: 140px; height: 50px\">\n  <div class=\"float\"></div>\n  <div class=\"bfc\" style=\"width: 75px; left: 0; top: -75px\"></div>\n</div>\n<div class=\"wrapper\" style=\"left: 270px; height: 50px\">\n  <div class=\"float\"></div>\n  <div class=\"bfc\" style=\"width: 50px; left: 50px; top: -25px\"></div>\n</div>\n<div class=\"wrapper\" style=\"left: 400px; height: 100px\">\n  <div class=\"float\"></div>\n  <div class=\"bfc\" style=\"width: 75px; left: 0px; top: 50px\"></div>\n</div>",
