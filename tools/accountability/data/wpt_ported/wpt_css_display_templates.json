  "wpt/css_display/display-flow-root-001": "<style type=\"text/css\">\nhtml,body {\n  color:black; background-color:white; font:16px/1 monospace; padding:0; margin:0;\n}\n\n.float {\n  float: left;\n  width: 20px;\n  height: 40px;\n  background: pink;\n}\n\n  </style>\n<div style=\"border:1px solid\"><span style=\"display:flow-root; margin: 20px 0\"><div style=\"margin: 20px 0\"></div></span></div><div style=\"border:1px solid\"><span style=\"display:flow-root\"><div class=\"float\"></div></span></div><div style=\"border:1px solid; margin-bottom:20px\"><div class=\"float\"></div><span style=\"display:flow-root; border:1px solid\"></span></div><span><span style=\"display:flow-root; background:grey;\"><div style=\"margin:20px\"></div></span></span><span style=\"display:flow-root; border:3px solid; height:10px;\"></span>",
  "wpt/css_display/display-flow-root-002-ref": "<style>\n  .float {\n    background-color: blue;\n    width: 250px;\n    height: 100px;\n  }\n  .left { float: left; }\n  .right { float: right; }\n\n  #outer { position: relative; width: 400px; }\n\n  #zerowidth {\n    position: absolute;\n    top: 100px;\n    left: 250px;\n    width: 0;\n    outline: 1px solid black;\n    height: 200px;\n  }\n</style>\n<div id=\"outer\"><div class=\"float right\"></div><div class=\"float left\"></div><div id=\"zerowidth\"></div></div>",
  "wpt/css_display/display-flow-root-002": "<style>\n  .float {\n    background-color: blue;\n    width: 250px;\n    height: 100px;\n  }\n  .left { float: left; }\n  .right { float: right; }\n\n  #outer { width: 400px; }\n\n  #zerowidth {\n    display: flow-root;\n    width: 0;\n    outline: 1px solid black;\n    height: 200px;\n  }\n</style>\n<div id=\"outer\"><div class=\"float right\"></div><div class=\"float left\"></div><div id=\"zerowidth\"></div></div>",
