  "wpt/css_display/display-contents-alignment-001-ref": "<style>\n  .container {\n    display: flex;\n    width: 300px;\n    height: 300px;\n    align-items: center;\n    border: 2px solid purple;\n  }\n  .container > div {\n    width: 100px;\n    height: 100px;\n    background: blue;\n    align-self: auto;\n  }\n</style>\n<div class=\"container\">\n  <div></div>\n</div>",
