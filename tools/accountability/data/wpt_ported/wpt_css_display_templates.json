  "wpt/css_display/display-flow-root-list-item-001": "<style type=\"text/css\">\nhtml,body {\n  color:black; background-color:white; font:16px/1 monospace; padding:0; margin:0;\n}\n\nbody { padding-left: 100px; }\n\n.float {\n  float: left;\n  width: 20px;\n  height: 40px;\n  background: pink;\n}\n\n.li { display: flow-root list-item; }\n  </style>\n<div style=\"border:1px solid\"><span class=\"li\" style=\"margin: 20px 0\"><div style=\"margin: 20px 0\"></div></span></div><div style=\"border:1px solid\"><span class=\"li\"><div class=\"float\"></div></span></div><div style=\"border:1px solid; margin-bottom:20px\"><div class=\"float\"></div><span class=\"li\" style=\"border:1px solid\"></span></div><span><span class=\"li\" style=\"background:grey;\"><div style=\"margin:20px\"></div></span></span><span class=\"li\" style=\"border:3px solid; height:10px;\"></span>"
