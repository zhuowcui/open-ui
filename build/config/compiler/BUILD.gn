import("//build/config/BUILD.gn")

config("default") {
  cflags_cc = [
    "-std=c++20",
    "-Wall",
    "-Wextra",
    "-Werror",
    "-Wno-unused-parameter",
    "-fPIC",
  ]

  cflags_c = [
    "-std=c17",
    "-Wall",
    "-Wextra",
    "-Werror",
    "-Wno-unused-parameter",
    "-fPIC",
  ]

  # Chromium's hermetic Clang understands and needs this diagnostic switch;
  # distro Clang 18 rejects it under -Werror. Keep the ABI build behavior while
  # allowing the standalone toolchain to compile portable targets.
  if (chromium_src != "") {
    cflags_cc += [ "-Wno-gcc-install-dir-libstdcxx" ]
    cflags_c += [ "-Wno-gcc-install-dir-libstdcxx" ]
  }

  if (is_debug) {
    cflags_cc += [
      "-g",
      "-O0",
    ]
    cflags_c += [
      "-g",
      "-O0",
    ]
    defines = [ "OUI_DEBUG=1" ]
  } else {
    cflags_cc += [
      "-O2",
      "-DNDEBUG",
    ]
    cflags_c += [
      "-O2",
      "-DNDEBUG",
    ]
  }
}
