+                        } else {
+                            1.0
+                        };
+                        let table_size = if index == 0 {
+                            first_body + 40.0
+                        } else if last {
+                            body_size + 40.0
+                        } else {
+                            outer_height.max(21.0)
+                        };
+                        let x = 120.0 + index as f32 * 37.75;
+                        assert_eq!(
+                            *table_rect,
