+                                x,
+                                y: if index == 0 { 60.0 } else { 120.0 },
+                                width: 20.0,
+                                height: table_size,
+                            }
+                        );
+                        assert_eq!(
+                            *body_rect,
+                            SceneRect {
+                                x,
+                                y: if index == 0 { 80.0 } else { 140.0 },
+                                width: 20.0,
+                                height: body_size,
+                            }
+                        );
+                    }
+                }
+                engine.remove(outer).unwrap();
+                assert_eq!(engine.client_rects(table), Err(EngineError::StaleHandle));
+            }
+        }
+    }
