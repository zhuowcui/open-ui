+    fn refresh_inherited_descendants(&mut self, parent: NodeId) -> Result<(), EngineError> {
+        let children: Vec<_> = self.document.children(parent).collect();
+        for child in children {
+            self.refresh_inherited_styles(child)?;
+        }
+        Ok(())
+    }
