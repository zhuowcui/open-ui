+    #[test]
+    fn offscreen_viewport_fixed_reveal_preserves_document_scroll() {
+        for position in [Position::Fixed, Position::Absolute] {
+            for smooth in [false, true] {
+                let (mut engine, outer, inner, target) = nested();
+                let root = engine.root();
+                let filler = box_node(&mut engine, root, 320.0, 1000.0);
+                engine.insert_before(root, filler, outer).unwrap();
+                engine
+                    .set_property(outer, StyleProperty::Position, Position::Static.into())
+                    .unwrap();
+                engine
+                    .set_property(
+                        outer,
+                        StyleProperty::MarginLeft,
+                        LengthValue::px(40.0).into(),
+                    )
+                    .unwrap();
+                engine
+                    .set_property(
+                        outer,
+                        StyleProperty::MarginTop,
+                        LengthValue::px(30.0).into(),
+                    )
+                    .unwrap();
+                engine
+                    .set_property(
+                        target,
+                        StyleProperty::MarginLeft,
+                        LengthValue::px(0.0).into(),
+                    )
+                    .unwrap();
+                engine
+                    .set_property(
+                        target,
+                        StyleProperty::MarginTop,
+                        LengthValue::px(0.0).into(),
+                    )
+                    .unwrap();
+                engine
+                    .set_property(target, StyleProperty::Position, position.into())
+                    .unwrap();
+                engine
+                    .set_property(target, StyleProperty::Left, LengthValue::px(280.0).into())
+                    .unwrap();
+                engine
+                    .set_property(target, StyleProperty::Top, LengthValue::px(500.0).into())
+                    .unwrap();
+                if smooth {
+                    engine
+                        .smooth_scroll_into_view(target, nearest(), 100.0)
+                        .unwrap();
+                    engine.set_animation_time(100.0).unwrap();
+                } else {
+                    engine.scroll_into_view(target, nearest()).unwrap();
+                }
+                let fixed = position == Position::Fixed;
+                assert_eq!(
+                    engine.scroll_offset(root).unwrap(),
+                    (0.0, if fixed { 0.0 } else { 280.0 })
+                );
+                assert_eq!(engine.scroll_offset(outer).unwrap(), (0.0, 0.0));
+                assert_eq!(engine.scroll_offset(inner).unwrap(), (0.0, 0.0));
+                let bounds = engine.bounds(target).unwrap().unwrap();
+                assert_eq!(
+                    (bounds.x, bounds.y),
+                    (280.0, if fixed { 500.0 } else { 220.0 })
+                );
+                assert!(!engine.is_animating());
+            }
+        }
+    }
+
+    #[test]
+    fn descendant_reveal_can_scroll_fixed_container_without_scrolling_document() {
+        let (mut engine, outer, inner, target) = nested();
+        let root = engine.root();
+        let filler = box_node(&mut engine, root, 320.0, 1000.0);
+        engine.insert_before(root, filler, outer).unwrap();
+        engine
+            .set_property(outer, StyleProperty::Position, Position::Fixed.into())
+            .unwrap();
+        engine.scroll_into_view(target, nearest()).unwrap();
+        assert_eq!(engine.scroll_offset(inner).unwrap(), (0.0, 40.0));
+        assert_eq!(engine.scroll_offset(outer).unwrap(), (70.0, 220.0));
+        assert_eq!(engine.scroll_offset(root).unwrap(), (0.0, 0.0));
+        let bounds = engine.bounds(target).unwrap().unwrap();
+        assert_eq!((bounds.x, bounds.y), (120.0, 90.0));
+    }
