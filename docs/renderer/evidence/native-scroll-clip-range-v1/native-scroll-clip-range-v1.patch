@@ -0,0 +1,71 @@
+//! Consuming native Rust app for scroll clip coverage across display scales.
+use openui::prelude::*;
+
+fn child(document: &Document, scroller: &Element) -> Result<Element, Error> {
+    let element = Element::create(document, "div")?;
+    element.set_width(LengthValue::px(600.0))?;
+    element.set_height(LengthValue::px(300.0))?;
+    element.set_margin_bottom(LengthValue::px(20.0))?;
+    element.set_background_color(Color::from_rgba8(0, 128, 0, 255))?;
+    scroller.append_child(&element)?;
+    Ok(element)
+}
+
+fn main() -> Result<(), Box<dyn std::error::Error>> {
+    let mut args = std::env::args().skip(1);
+    let png = args.next().ok_or("PNG path required")?;
+    let scale: f64 = args.next().ok_or("display scale required")?.parse()?;
+    let phase: f32 = args.next().ok_or("position phase required")?.parse()?;
+    let geometry = args.next().ok_or("geometry path required")?;
+    let children: usize = args
+        .next()
+        .map(|value| value.parse())
+        .transpose()?
+        .unwrap_or(2);
+    if !matches!(children, 1 | 2) {
+        return Err("expected one or two children".into());
+    }
+    let metrics_path = args.next();
+    let document =
+        Document::with_viewport_metrics(ViewportMetrics::from_logical_size(640.0, 480.0, scale)?)?;
+    let root = document.body();
+    root.set_background_color(Color::WHITE)?;
+    root.set_scrollbar_width(ScrollbarWidth::None)?;
+    let scroller = Element::create(&document, "div")?;
+    scroller.set_position(Position::Absolute)?;
+    scroller.set_left(Length::px(20.0 + phase))?;
+    scroller.set_top(Length::px(46.0 + phase))?;
+    scroller.set_width(LengthValue::px(600.0))?;
+    scroller.set_height(LengthValue::px(300.0))?;
+    scroller.set_overflow(Overflow::Scroll)?;
+    scroller.set_scrollbar_width(ScrollbarWidth::None)?;
+    root.append_child(&scroller)?;
+    let target = child(&document, &scroller)?;
+    let _second = if children == 2 {
+        Some(child(&document, &scroller)?)
+    } else {
+        None
+    };
+    let bounds = target.bounding_rect()?.ok_or("missing native bounds")?;
+    std::fs::write(png, document.render_to_png_buffer()?)?;
+    std::fs::write(
+        geometry,
+        format!(
+            "{{\"x\":{},\"y\":{},\"width\":{},\"height\":{}}}\n",
+            bounds.x, bounds.y, bounds.width, bounds.height
+        ),
+    )?;
+    if let Some(path) = metrics_path {
+        let metrics = scroller.scroll_metrics()?.ok_or("missing native metrics")?;
+        std::fs::write(
+            path,
+            format!(
+                "{{\"bounds\":{{\"x\":{},\"y\":{},\"width\":{},\"height\":{}}},\"clientWidth\":{},\"clientHeight\":{},\"scrollWidth\":{},\"scrollHeight\":{},\"scrollTop\":{},\"scrollLeft\":{}}}\n",
+                bounds.x, bounds.y, bounds.width, bounds.height, metrics.client_width,
+                metrics.client_height, metrics.scroll_width, metrics.scroll_height,
+                scroller.scroll_top()?, scroller.scroll_left()?,
+            ),
+        )?;
+    }
+    Ok(())
+}
