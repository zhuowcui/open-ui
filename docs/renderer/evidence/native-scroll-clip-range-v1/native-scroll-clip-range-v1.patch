+/// In-flow bounds include margins before the scroll container's padding is
+/// added. Ink overflow alone omits a trailing margin and can therefore erase
+/// a real scroll range. Blink's BoxFragmentBuilder clamps the margin on the
+/// scroll-origin side to zero, and the margin on the reachable side to minus
+/// the child's size. Keep these layout bounds separate from propagated ink.
+fn inflow_child_bounds(
+    doc: &Document,
+    parent: &Fragment,
+    child: &Fragment,
+    client: PhysicalRect,
+    negative_x: bool,
+    negative_y: bool,
+) -> PhysicalRect {
+    let bounds = PhysicalRect::new(child.offset, child.size);
+    if child.node_id.is_none() {
+        return bounds;
+    }
+    let parent_style = &doc.node(parent.node_id).style;
+    let child_style = &doc.node(child.node_id).style;
+    let content_width =
+        (client.width() - parent.padding.left - parent.padding.right).clamp_negative_to_zero();
+    let content_height =
+        (client.height() - parent.padding.top - parent.padding.bottom).clamp_negative_to_zero();
+    let inline_size = if parent_style.writing_mode == WritingMode::HorizontalTb {
+        content_width
+    } else {
+        content_height
+    };
+    // Used block margins can contain the width-equation remainder. Blink's
+    // inflow bounds use authored margins, with auto resolving to zero.
+    let mut margins = crate::block::resolve_margins(child_style, inline_size);
+    let (left, right) = if negative_x {
+        (
+            margins.left.max_of(-child.size.width),
+            margins.right.clamp_negative_to_zero(),
+        )
+    } else {
+        (
+            margins.left.clamp_negative_to_zero(),
+            margins.right.max_of(-child.size.width),
+        )
+    };
+    let (top, bottom) = if negative_y {
+        (
+            margins.top.max_of(-child.size.height),
+            margins.bottom.clamp_negative_to_zero(),
+        )
+    } else {
+        (
+            margins.top.clamp_negative_to_zero(),
+            margins.bottom.max_of(-child.size.height),
+        )
+    };
+    margins = BoxStrut::new(top, right, bottom, left);
+    // Relative positioning moves ink, not the original in-flow padding area.
+    let relative = if child_style.position == openui_style::Position::Relative {
+        crate::relative::compute_relative_offset(child_style, content_width, content_height)
+    } else {
+        PhysicalOffset::zero()
+    };
+    PhysicalRect::from_xywh(
+        child.offset.left - relative.left - margins.left,
+        child.offset.top - relative.top - margins.top,
+        child.size.width + margins.left + margins.right,
+        child.size.height + margins.top + margins.bottom,
+    )
+}
