+    /// Resolve inherited writing mode before queries and layout. An authored
+    /// value, including an explicit initial value, overrides inheritance.
+    /// Anonymous and pseudo style snapshots arrive fully resolved and keep
+    /// their supplied value; their descendants inherit from that value.
+    fn refresh_inherited_writing_modes(&mut self, root: NodeId) {
+        let mut pending = vec![root];
+        while let Some(node) = pending.pop() {
+            let index = self.node_slots.get(&node).copied();
+            let inherits = index.is_some_and(|index| {
+                let slot = &self.slots[index as usize];
+                !slot.resolved_style_snapshot
+                    && !slot
+                        .authored
+                        .contains_key(&(StyleProperty::WritingMode as u16))
+            });
+            if inherits {
+                let parent = self.document.node(node).parent;
+                let writing_mode = if parent.is_none() {
+                    openui_style::WritingMode::HorizontalTb
+                } else {
+                    self.document.node(parent).style.writing_mode
+                };
+                self.document.update_resolved_style(node, |style| {
+                    style.writing_mode = writing_mode;
+                });
+            }
+            let children: Vec<_> = self.document.children(node).collect();
+            pending.extend(children.into_iter().rev());
+        }
+    }
