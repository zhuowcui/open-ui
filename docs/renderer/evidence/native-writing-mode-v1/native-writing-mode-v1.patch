+    #[test]
+    fn native_writing_mode_inheritance_tracks_attachment_mutation_and_reparenting() {
+        use openui_style::WritingMode;
+        let mut engine =
+            Engine::new(ViewportMetrics::from_logical_size(640.0, 480.0, 1.0).unwrap()).unwrap();
+        let vertical = engine.create_native_element(ElementTag::Div).unwrap();
+        let horizontal = engine.create_native_element(ElementTag::Div).unwrap();
+        let wrapper = engine.create_native_element(ElementTag::Div).unwrap();
+        let child = engine.create_native_element(ElementTag::Div).unwrap();
+        engine.append_child(engine.root(), vertical).unwrap();
+        engine.append_child(engine.root(), horizontal).unwrap();
+        engine.append_child(wrapper, child).unwrap();
+        engine
+            .set_property(
+                vertical,
+                StyleProperty::WritingMode,
+                WritingMode::VerticalRl.into(),
+            )
+            .unwrap();
+        engine.append_child(vertical, wrapper).unwrap();
+        assert_eq!(
+            engine.computed_style(wrapper).unwrap().writing_mode,
+            WritingMode::VerticalRl
+        );
+        assert_eq!(
+            engine.computed_style(child).unwrap().writing_mode,
+            WritingMode::VerticalRl
+        );
+        let owned = engine.computed_style(child).unwrap().clone();
+        engine
+            .set_property(
+                vertical,
+                StyleProperty::WritingMode,
+                WritingMode::VerticalLr.into(),
+            )
+            .unwrap();
+        assert_eq!(
+            engine.computed_style(child).unwrap().writing_mode,
+            WritingMode::VerticalLr
+        );
+        assert_eq!(owned.writing_mode, WritingMode::VerticalRl);
+        engine
+            .set_property(
+                child,
+                StyleProperty::WritingMode,
+                WritingMode::HorizontalTb.into(),
+            )
+            .unwrap();
+        engine.append_or_move_child(horizontal, wrapper).unwrap();
+        assert_eq!(
+            engine.computed_style(wrapper).unwrap().writing_mode,
+            WritingMode::HorizontalTb
+        );
+        engine.append_or_move_child(vertical, wrapper).unwrap();
+        assert_eq!(
+            engine.computed_style(wrapper).unwrap().writing_mode,
+            WritingMode::VerticalLr
+        );
+        assert_eq!(
+            engine.computed_style(child).unwrap().writing_mode,
+            WritingMode::HorizontalTb
+        );
+        engine.detach(wrapper).unwrap();
+        assert_eq!(
+            engine.computed_style(wrapper).unwrap().writing_mode,
+            WritingMode::HorizontalTb
+        );
+        let anchor = engine.create_native_element(ElementTag::Div).unwrap();
+        engine.append_child(vertical, anchor).unwrap();
+        engine.insert_before(vertical, wrapper, anchor).unwrap();
+        assert_eq!(
+            engine.computed_style(wrapper).unwrap().writing_mode,
+            WritingMode::VerticalLr
+        );
+    }
