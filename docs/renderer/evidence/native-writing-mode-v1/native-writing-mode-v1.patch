+    #[test]
+    fn native_writing_mode_preserves_resolved_snapshots_and_updates_text_clones() {
+        use openui_style::WritingMode;
+        let mut engine =
+            Engine::new(ViewportMetrics::from_logical_size(640.0, 480.0, 1.0).unwrap()).unwrap();
+        let parent = engine.create_native_element(ElementTag::Div).unwrap();
+        let child = engine.create_native_element(ElementTag::Div).unwrap();
+        let text = engine.create_text("native text").unwrap();
+        engine.append_child(engine.root(), parent).unwrap();
+        engine.append_child(child, text).unwrap();
+        engine.append_child(parent, child).unwrap();
+        engine
+            .set_property(
+                parent,
+                StyleProperty::WritingMode,
+                WritingMode::VerticalRl.into(),
+            )
+            .unwrap();
+        assert_eq!(
+            engine.computed_style(text).unwrap().writing_mode,
+            WritingMode::VerticalRl
+        );
+        let duplicate = engine.clone_subtree(child).unwrap();
+        let duplicate_text = engine.children(duplicate).unwrap()[0];
+        assert_eq!(
+            engine.computed_style(duplicate_text).unwrap().writing_mode,
+            WritingMode::HorizontalTb
+        );
+        engine.append_child(parent, duplicate).unwrap();
+        assert_eq!(
+            engine.computed_style(duplicate_text).unwrap().writing_mode,
+            WritingMode::VerticalRl
+        );
+        engine
+            .install_derived_style(child, ComputedStyle::initial())
+            .unwrap();
+        engine
+            .set_property(
+                parent,
+                StyleProperty::WritingMode,
+                WritingMode::VerticalLr.into(),
+            )
+            .unwrap();
+        assert_eq!(
+            engine.computed_style(child).unwrap().writing_mode,
+            WritingMode::HorizontalTb
+        );
+        assert_eq!(
+            engine.computed_style(text).unwrap().writing_mode,
+            WritingMode::HorizontalTb
+        );
+        assert_eq!(
+            engine.computed_style(duplicate_text).unwrap().writing_mode,
+            WritingMode::VerticalLr
+        );
+    }
