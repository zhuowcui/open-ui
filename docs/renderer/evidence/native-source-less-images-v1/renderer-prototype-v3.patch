+/// A sized native image without resource bytes or alternative text has a
+/// replaced background and a separate frame decoration. Blink paints the
+/// background under the content clip, then restores that clip before the frame.
+fn is_source_less_image_frame(doc: &Document, node_id: NodeId, style: &ComputedStyle) -> bool {
+    let node = doc.node(node_id);
+    node.tag == ElementTag::Image
+        && node.replaced.is_none()
+        && doc.attribute(node_id, "src").is_none()
+        && doc
+            .attribute(node_id, "alt")
+            .is_none_or(|alt| alt.is_empty())
+        && ((!style.width.is_auto() && !style.height.is_auto())
+            || (style.aspect_ratio.is_some()
+                && (!style.width.is_auto() || !style.height.is_auto())))
+}
+
+fn paint_source_less_image_frame(
+    canvas: &Canvas,
+    fragment: &Fragment,
+    style: &ComputedStyle,
+    abs_offset: PhysicalOffset,
+    opacity_multiplier: f32,
+) {
+    let left = abs_offset.left + fragment.border.left + fragment.padding.left;
+    let top = abs_offset.top + fragment.border.top + fragment.padding.top;
+    let right =
+        abs_offset.left + fragment.size.width - fragment.border.right - fragment.padding.right;
+    let bottom =
+        abs_offset.top + fragment.size.height - fragment.border.bottom - fragment.padding.bottom;
+    // ImagePainter tests the layout content size before pixel snapping. A
+    // fractional size above 2px can still produce a 2px snapped frame.
+    if (right - left).to_f32() <= 2.0 || (bottom - top).to_f32() <= 2.0 {
+        return;
+    }
+    let rect = Rect::from_ltrb(
+        left.round().to_f32(),
+        top.round().to_f32(),
+        right.round().to_f32(),
+        bottom.round().to_f32(),
+    );
+    let _clip = (style.has_border_radius() && !fragment.ignore_border_radius).then(|| {
+        let guard = skia_safe::AutoCanvasRestore::guard(canvas, true);
+        canvas.clip_rrect(
+            build_clip_rrect(
+                &rect,
+                fragment,
+                style,
+                OverflowClipBox::ContentBox,
+                0.0,
+                0.0,
+            ),
+            ClipOp::Intersect,
+            true,
+        );
+        guard
+    });
+    let mut frame = Paint::default();
+    frame.set_style(PaintStyle::Stroke);
+    frame.set_stroke_width(1.0);
+    frame.set_anti_alias(true);
+    frame.set_color4f(
+        Color4f::new(0.7529412, 0.7529412, 0.7529412, opacity_multiplier),
+        None::<&ColorSpace>,
+    );
+    canvas.draw_rect(
+        Rect::from_ltrb(
+            rect.left + 0.5,
+            rect.top + 0.5,
+            rect.right - 0.5,
+            rect.bottom - 0.5,
+        ),
+        &frame,
+    );
+}
