+/// Physical lower bound of the device clip that sizes a nested image layer.
+/// Keep authored fractional edges until after device scale: rounding the clip
+/// in CSS pixels first can choose a different backing origin and image sample.
+struct RasterClipOriginGuard((i32, i32));
+
+impl RasterClipOriginGuard {
+    fn intersect(canvas: &Canvas, rect: Rect, scale: f32) -> Self {
+        let rect = canvas.local_to_device_as_3x3().map_rect(rect).0;
+        let next = (
+            (rect.left * scale).floor() as i32,
+            (rect.top * scale).floor() as i32,
+        );
+        RASTER_CLIP_ORIGIN.with(|origin| {
+            let previous = *origin.borrow();
+            *origin.borrow_mut() = (previous.0.max(next.0), previous.1.max(next.1));
+            Self(previous)
+        })
+    }
+}
+
+impl Drop for RasterClipOriginGuard {
+    fn drop(&mut self) {
+        RASTER_CLIP_ORIGIN.with(|origin| *origin.borrow_mut() = self.0);
+    }
 }

