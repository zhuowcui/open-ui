+fn image_opacity_bounds(
+    fragment: &Fragment,
+    doc: &Document,
+    offset: PhysicalOffset,
+) -> Option<Rect> {
+    fn collect(
+        fragment: &Fragment,
+        doc: &Document,
+        offset: PhysicalOffset,
+        inherited_transform: Matrix,
+        is_group_root: bool,
+        bounds: &mut Option<Rect>,
+    ) {
+        let mut transform = inherited_transform;
+        if !is_group_root && !fragment.node_id.is_none() {
+            let style = &doc.node(fragment.node_id).style;
+            if style.transform != openui_style::Transform2D::IDENTITY {
+                transform.pre_concat(&fragment_transform_matrix(style, fragment, offset));
+            }
+        }
+        if !fragment.node_id.is_none() {
+            let node = doc.node(fragment.node_id);
+            let style = &node.style;
+            let background = fragment
+                .paint_background_color_override
+                .unwrap_or(style.background_color);
+            let own_content = fragment.kind == FragmentKind::Text
+                || node.tag == ElementTag::Image
+                || node.replaced.is_some()
+                || !background.is_transparent()
+                || !style.background_layers.is_empty()
+                || style.background_linear_gradient.is_some()
+                || style.effective_border_top() > 0
+                || style.effective_border_right() > 0
+                || style.effective_border_bottom() > 0
+                || style.effective_border_left() > 0
+                || style.has_outline()
+                || !style.box_shadow.is_empty();
+            if style.visibility == Visibility::Visible && own_content {
+                let owned = fragment.border_box_rect();
+                let mut rect = Rect::from_xywh(
+                    offset.left.to_f32() + owned.offset.left.to_f32(),
+                    offset.top.to_f32() + owned.offset.top.to_f32(),
+                    owned.size.width.to_f32(),
+                    owned.size.height.to_f32(),
+                );
+                if fragment.kind != FragmentKind::Text
+                    && node.tag != ElementTag::Image
+                    && node.replaced.is_none()
+                {
+                    rect = Rect::from_ltrb(
+                        rect.left.round(),
+                        rect.top.round(),
+                        rect.right.round(),
+                        rect.bottom.round(),
+                    );
+                }
+                if !rect.is_empty() {
+                    let border_rect = rect;
+                    if style.has_outline() {
+                        let extent =
+                            (style.effective_outline_width() + style.outline_offset).max(0) as f32;
+                        rect.join(Rect::from_ltrb(
+                            border_rect.left - extent,
+                            border_rect.top - extent,
+                            border_rect.right + extent,
+                            border_rect.bottom + extent,
+                        ));
+                    }
+                    for shadow in &style.box_shadow {
+                        if !shadow.inset {
+                            let extent = (3.0 * css_shadow_blur_sigma(shadow.blur_radius)).ceil()
+                                + shadow.spread_radius;
+                            rect.join(Rect::from_ltrb(
+                                border_rect.left + shadow.offset_x - extent,
+                                border_rect.top + shadow.offset_y - extent,
+                                border_rect.right + shadow.offset_x + extent,
+                                border_rect.bottom + shadow.offset_y + extent,
+                            ));
+                        }
+                    }
+                    let rect = transform.map_rect(rect).0;
+                    match bounds {
+                        Some(bounds) => bounds.join(rect),
+                        None => *bounds = Some(rect),
+                    }
+                }
+            }
+        }
+        for child in &fragment.children {
+            collect(
+                child,
+                doc,
+                PhysicalOffset::new(
+                    offset.left + child.offset.left,
+                    offset.top + child.offset.top,
+                ),
+                transform,
+                false,
+                bounds,
+            );
+        }
+    }
+
+    let mut bounds = None;
+    collect(
+        fragment,
+        doc,
+        offset,
+        Matrix::new_identity(),
+        true,
+        &mut bounds,
+    );
+    bounds.map(|bounds| {
+        Rect::from_ltrb(
+            bounds.left.floor(),
+            bounds.top.floor(),
+            bounds.right.ceil(),
+            bounds.bottom.ceil(),
+        )
+    })
+}
