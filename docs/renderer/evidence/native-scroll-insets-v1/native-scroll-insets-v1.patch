+                right: LengthValue::px(6.0),
+                bottom: LengthValue::px(8.0),
+                left: LengthValue::px(12.0),
+            })?;
+        }
+        "percent-padding" => {
+            outer.set_scroll_padding(Edges::all(LengthValue::percent(12.5)))?;
+            inner.set_scroll_padding(Edges::all(LengthValue::percent(20.0)))?;
+        }
+        "collapsed-padding" => {
+            outer.set_scroll_padding(Edges::all(LengthValue::px(200.0)))?;
+            inner.set_scroll_padding(Edges::all(LengthValue::px(200.0)))?;
+        }
+        "oversized-margin" => target.set_scroll_margin(Edges::all(LengthValue::px(100.0)))?,
+        "start" | "center" | "end" => {
+            target.set_scroll_margin(Edges::all(LengthValue::px(10.0)))?;
+            outer.set_scroll_padding(Edges::all(LengthValue::px(10.0)))?;
+            inner.set_scroll_padding(Edges::all(LengthValue::px(10.0)))?;
+            options.block = match case {
+                "start" => ScrollAlignment::Start,
+                "center" => ScrollAlignment::Center,
+                _ => ScrollAlignment::End,
