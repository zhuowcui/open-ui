+use openui_geometry::{LayoutUnit, Length, LengthType};
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+enum Side {
+    Top,
+    Right,
+    Bottom,
+    Left,
+    BlockStart,
+    BlockEnd,
+    InlineStart,
+    InlineEnd,
+}
+
+impl Side {
+    fn physical(self, style: &ComputedStyle) -> usize {
+        use Side::*;
+        match self {
+            Top => 0,
+            Right => 1,
+            Bottom => 2,
+            Left => 3,
+            BlockStart | BlockEnd => {
+                let start = if style.writing_mode.is_horizontal() {
+                    0
+                } else if style.writing_mode.is_flipped_blocks() {
+                    1
+                } else {
+                    3
+                };
+                if self == BlockStart {
+                    start
+                } else {
+                    (start + 2) % 4
+                }
+            }
+            InlineStart | InlineEnd => {
+                let reversed = (style.direction == Direction::Rtl)
+                    ^ (style.writing_mode == WritingMode::SidewaysLr);
+                let start = if style.writing_mode.is_horizontal() {
+                    if reversed {
+                        1
+                    } else {
+                        3
+                    }
+                } else if reversed {
+                    2
+                } else {
+                    0
+                };
+                if self == InlineStart {
+                    start
+                } else {
+                    (start + 2) % 4
+                }
+            }
+        }
+    }
+
+    fn logical(self) -> bool {
+        matches!(
+            self,
+            Self::BlockStart | Self::BlockEnd | Self::InlineStart | Self::InlineEnd
+        )
+    }
+
+    fn can_overlap(self, other: Self) -> bool {
+        self == other || self.logical() != other.logical()
+    }
+}
+
+/// Bounded declaration order needed when physical and logical native setters
+/// share a side. This owns no document or callback.
+#[doc(hidden)]
+#[derive(Debug, Clone, Default)]
+pub struct ScrollInsetDeclarations(Vec<(Side, LengthValue)>);
+
+fn descriptor(property: StyleProperty) -> Option<(bool, Option<Side>)> {
+    use Side::*;
+    use StyleProperty as P;
+    Some(match property {
+        P::ScrollMargin => (false, None),
+        P::ScrollMarginTop => (false, Some(Top)),
+        P::ScrollMarginRight => (false, Some(Right)),
+        P::ScrollMarginBottom => (false, Some(Bottom)),
+        P::ScrollMarginLeft => (false, Some(Left)),
+        P::ScrollMarginBlockStart => (false, Some(BlockStart)),
+        P::ScrollMarginBlockEnd => (false, Some(BlockEnd)),
+        P::ScrollMarginInlineStart => (false, Some(InlineStart)),
+        P::ScrollMarginInlineEnd => (false, Some(InlineEnd)),
+        P::ScrollPadding => (true, None),
+        P::ScrollPaddingTop => (true, Some(Top)),
+        P::ScrollPaddingRight => (true, Some(Right)),
+        P::ScrollPaddingBottom => (true, Some(Bottom)),
+        P::ScrollPaddingLeft => (true, Some(Left)),
+        P::ScrollPaddingBlockStart => (true, Some(BlockStart)),
+        P::ScrollPaddingBlockEnd => (true, Some(BlockEnd)),
+        P::ScrollPaddingInlineStart => (true, Some(InlineStart)),
+        P::ScrollPaddingInlineEnd => (true, Some(InlineEnd)),
+        _ => return None,
+    })
+}
+
+pub(crate) fn is_scroll_inset(property: StyleProperty) -> bool {
+    descriptor(property).is_some()
+}
+
+impl StyleProperty {
+    #[doc(hidden)]
+    pub fn is_scroll_inset(self) -> bool {
+        is_scroll_inset(self)
+    }
+}
+
+pub(crate) fn is_scroll_inset_shorthand(property: StyleProperty) -> bool {
+    matches!(
+        property,
+        StyleProperty::ScrollMargin | StyleProperty::ScrollPadding
+    )
+}
+
+fn lengths(property: StyleProperty, value: &StyleValue) -> Option<Vec<(Side, LengthValue)>> {
+    let (_, side) = descriptor(property)?;
+    if let Some(side) = side {
+        let value = match value {
+            StyleValue::Length(value) => *value,
+            StyleValue::Renderer(value) if value.property() == property => {
+                use RendererStyleValue as R;
+                match value {
+                    R::ScrollMarginTop(value)
+                    | R::ScrollMarginRight(value)
+                    | R::ScrollMarginBottom(value)
+                    | R::ScrollMarginLeft(value)
+                    | R::ScrollPaddingTop(value)
+                    | R::ScrollPaddingRight(value)
+                    | R::ScrollPaddingBottom(value)
+                    | R::ScrollPaddingLeft(value) => (*value).into(),
+                    _ => return None,
+                }
+            }
+            _ => return None,
+        };
+        Some(vec![(side, value)])
+    } else if let StyleValue::Edges(value) = value {
+        Some(vec![
+            (Side::Top, value.top),
+            (Side::Right, value.right),
+            (Side::Bottom, value.bottom),
+            (Side::Left, value.left),
+        ])
+    } else {
+        None
+    }
+}
+
+fn valid_length(padding: bool, value: LengthValue) -> bool {
+    let (number, valid_kind) = match value {
+        LengthValue::Computed(value) => (
+            value.value(),
+            match value.length_type() {
+                LengthType::Fixed | LengthType::Calculated => true,
+                LengthType::Percent | LengthType::Auto => padding,
+                _ => false,
+            },
+        ),
+        LengthValue::Em(v)
+        | LengthValue::Rem(v)
+        | LengthValue::ViewportWidth(v)
+        | LengthValue::ViewportHeight(v)
+        | LengthValue::ViewportMin(v)
+        | LengthValue::ViewportMax(v) => (v, true),
+    };
+    valid_kind && number.is_finite() && (!padding || number >= 0.0)
+}
+
+pub(crate) fn valid_scroll_inset_value(property: StyleProperty, value: &StyleValue) -> bool {
+    let Some((padding, _)) = descriptor(property) else {
+        return false;
+    };
+    lengths(property, value).is_some_and(|values| {
+        values
+            .into_iter()
+            .all(|(_, value)| valid_length(padding, value))
+    })
+}
+
+pub(crate) fn apply_scroll_inset(
+    style: &mut ComputedStyle,
+    property: StyleProperty,
+    value: &StyleValue,
+    viewport: (f32, f32),
+) -> Option<Result<InvalidationClass, PropertyTypeError>> {
+    let (padding, _) = descriptor(property)?;
+    let failure = || PropertyTypeError {
+        property,
+        expected: property.metadata().value_kind,
+    };
+    let Some(values) = lengths(property, value) else {
+        return Some(Err(failure()));
+    };
+    // Validate the whole shorthand before changing any retained declaration.
+    if values.iter().any(|(_, value)| {
+        !valid_length(padding, *value)
+            || !value
+                .resolve(viewport, style.font_size, 16.0)
+                .value()
+                .is_finite()
+    }) {
+        return Some(Err(failure()));
+    }
+    let declarations = if padding {
+        &mut style.fields.scroll_padding_declarations.0
+    } else {
+        &mut style.fields.scroll_margin_declarations.0
+    };
+    for (side, value) in values {
+        declarations.retain(|(previous, _)| *previous != side);
+        declarations.push((side, value));
+    }
+    style.resolve_scroll_insets(viewport, 16.0);
+    Some(Ok(property.metadata().invalidation))
+}
+
+impl ComputedStyle {
+    /// Reproject native logical declarations after writing mode, font or
+    /// viewport changes. Relative values remain authored until this boundary.
+    #[doc(hidden)]
+    pub fn resolve_scroll_insets(&mut self, viewport: (f32, f32), root_font_size: f32) {
+        let resolve = |declarations: &ScrollInsetDeclarations, initial: Length| {
+            let mut values = [initial; 4];
+            for (side, value) in &declarations.0 {
+                values[side.physical(self)] =
+                    value.resolve(viewport, self.font_size, root_font_size);
+            }
+            values
+        };
+        let margin = resolve(&self.fields.scroll_margin_declarations, Length::zero());
+        let padding = resolve(&self.fields.scroll_padding_declarations, Length::auto());
+        if !self.fields.scroll_margin_declarations.0.is_empty() {
+            [
+                self.fields.scroll_margin_top,
+                self.fields.scroll_margin_right,
+                self.fields.scroll_margin_bottom,
+                self.fields.scroll_margin_left,
+            ] = margin;
+        }
+        if !self.fields.scroll_padding_declarations.0.is_empty() {
+            [
+                self.fields.scroll_padding_top,
+                self.fields.scroll_padding_right,
+                self.fields.scroll_padding_bottom,
+                self.fields.scroll_padding_left,
+            ] = padding;
+        }
+    }
+
+    /// A repeated declaration is a no-op only if later aliases cannot change
+    /// its winning side, including after a later writing-mode change.
+    #[doc(hidden)]
+    pub fn scroll_inset_declaration_is_current(
+        &self,
+        property: StyleProperty,
+        value: &StyleValue,
+    ) -> bool {
+        let Some((padding, _)) = descriptor(property) else {
+            return true;
+        };
+        let Some(values) = lengths(property, value) else {
+            return false;
+        };
+        let declarations = if padding {
+            &self.fields.scroll_padding_declarations.0
+        } else {
+            &self.fields.scroll_margin_declarations.0
+        };
+        values.into_iter().all(|(side, value)| {
+            declarations
+                .iter()
+                .position(|(other, stored)| *other == side && *stored == value)
+                .is_some_and(|index| {
+                    !declarations[index + 1..]
+                        .iter()
+                        .any(|(later, _)| side.can_overlap(*later))
+                })
+        })
+    }
+
+    /// Physical margin outsets in Blink's 1/64-pixel geometry units.
+    #[doc(hidden)]
+    pub fn resolved_scroll_margin(&self) -> Edges<f32> {
+        let pixels = |value: Length| LayoutUnit::from_f32(value.value()).to_f32();
+        Edges {
+            top: pixels(self.scroll_margin_top),
+            right: pixels(self.scroll_margin_right),
+            bottom: pixels(self.scroll_margin_bottom),
+            left: pixels(self.scroll_margin_left),
+        }
+    }
+
+    /// Percentages resolve against the corresponding scrollport dimension.
+    #[doc(hidden)]
+    pub fn resolved_scroll_padding(&self, width: f32, height: f32) -> Edges<f32> {
+        let pixels = |value: Length, basis: f32| {
+            LayoutUnit::from_f32(match value.length_type() {
+                LengthType::Auto => 0.0,
+                LengthType::Percent => basis * value.value() / 100.0,
+                _ => value.value(),
+            })
+            .to_f32()
+        };
+        Edges {
+            top: pixels(self.scroll_padding_top, height),
+            right: pixels(self.scroll_padding_right, width),
+            bottom: pixels(self.scroll_padding_bottom, height),
+            left: pixels(self.scroll_padding_left, width),
+        }
+    }
+}
+
+pub(crate) fn read_scroll_inset(
+    style: &ComputedStyle,
+    property: StyleProperty,
+) -> Option<StyleValue> {
+    let (padding, side) = descriptor(property)?;
+    let values = if padding {
+        [
+            style.scroll_padding_top,
+            style.scroll_padding_right,
+            style.scroll_padding_bottom,
+            style.scroll_padding_left,
+        ]
+    } else {
+        [
+            style.scroll_margin_top,
+            style.scroll_margin_right,
+            style.scroll_margin_bottom,
+            style.scroll_margin_left,
+        ]
+    };
+    Some(if let Some(side) = side {
+        StyleValue::Length(values[side.physical(style)].into())
+    } else {
+        StyleValue::Edges(Edges {
+            top: values[0].into(),
+            right: values[1].into(),
+            bottom: values[2].into(),
+            left: values[3].into(),
+        })
+    })
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::{apply_to_computed, parse_literal, value_from_computed};
+
+    fn set(style: &mut ComputedStyle, property: StyleProperty, value: impl Into<StyleValue>) {
+        apply_to_computed(style, property, &value.into(), (320.0, 240.0)).unwrap();
+    }
+
+    #[test]
+    fn native_literal_and_typed_validation_agree_without_partial_mutation() {
+        for (property, accepted, rejected) in [
+            (StyleProperty::ScrollMargin, "-2px 1em 0 3rem", "2px 5%"),
+            (StyleProperty::ScrollPadding, "auto 20% 3px 1em", "1px -2px"),
+            (StyleProperty::ScrollMarginInlineStart, "-1.5px", "auto"),
+            (StyleProperty::ScrollPaddingBlockEnd, "12.5%", "none"),
+        ] {
+            let mut style = ComputedStyle::default();
+            set(
+                &mut style,
+                property,
+                parse_literal(property, accepted).unwrap(),
+            );
+            let before = value_from_computed(&style, property);
+            assert!(parse_literal(property, rejected).is_err());
+            let invalid = if is_scroll_inset_shorthand(property) {
+                StyleValue::Edges(Edges {
+                    top: LengthValue::px(5.0),
+                    right: LengthValue::px(f32::NAN),
+                    bottom: LengthValue::px(7.0),
+                    left: LengthValue::px(9.0),
+                })
+            } else {
+                LengthValue::px(f32::INFINITY).into()
+            };
+            assert!(apply_to_computed(&mut style, property, &invalid, (320.0, 240.0)).is_err());
+            assert_eq!(value_from_computed(&style, property), before);
+        }
+    }
+
+    #[test]
+    fn logical_insets_follow_all_native_writing_modes_and_directions() {
+        for (mode, ltr_side, rtl_side) in [
+            (WritingMode::HorizontalTb, 3, 1),
+            (WritingMode::VerticalRl, 0, 2),
+            (WritingMode::VerticalLr, 0, 2),
+            (WritingMode::SidewaysRl, 0, 2),
+            (WritingMode::SidewaysLr, 2, 0),
+        ] {
+            for (direction, side) in [(Direction::Ltr, ltr_side), (Direction::Rtl, rtl_side)] {
+                let mut style = ComputedStyle::default();
+                set(
+                    &mut style,
+                    StyleProperty::ScrollMarginInlineStart,
+                    LengthValue::px(17.0),
+                );
+                set(&mut style, StyleProperty::WritingMode, mode);
+                set(&mut style, StyleProperty::Direction, direction);
+                let margin = style.resolved_scroll_margin();
+                let mut expected = [0.0; 4];
+                expected[side] = 17.0;
+                assert_eq!(
+                    [margin.top, margin.right, margin.bottom, margin.left],
+                    expected
+                );
+                assert_eq!(
+                    value_from_computed(&style, StyleProperty::ScrollMarginInlineStart),
+                    LengthValue::px(17.0).into()
+                );
+            }
+        }
+    }
+
+    #[test]
+    fn physical_and_logical_insets_reproject_in_declaration_order() {
+        let mut style = ComputedStyle::default();
+        set(
+            &mut style,
+            StyleProperty::ScrollMarginInlineStart,
+            LengthValue::px(17.0),
+        );
+        set(
+            &mut style,
+            StyleProperty::ScrollMarginLeft,
+            LengthValue::px(7.0),
+        );
+        assert_eq!(style.scroll_margin_left.value(), 7.0);
+        set(
+            &mut style,
+            StyleProperty::ScrollMarginInlineStart,
+            LengthValue::px(17.0),
+        );
+        assert_eq!(style.scroll_margin_left.value(), 17.0);
+        set(
+            &mut style,
+            StyleProperty::WritingMode,
+            WritingMode::VerticalRl,
+        );
+        assert_eq!(style.scroll_margin_left.value(), 7.0);
+        assert_eq!(style.scroll_margin_top.value(), 17.0);
+        set(&mut style, StyleProperty::Direction, Direction::Rtl);
+        assert_eq!(style.scroll_margin_bottom.value(), 17.0);
+        assert_eq!(style.scroll_margin_top.value(), 0.0);
+        // An owned snapshot keeps its own declaration history.
+        let snapshot = style.clone();
+        set(
+            &mut style,
+            StyleProperty::ScrollMargin,
+            Edges::all(LengthValue::px(2.0)),
+        );
+        assert_eq!(style.scroll_margin_bottom.value(), 2.0);
+        assert_eq!(snapshot.scroll_margin_bottom.value(), 17.0);
+    }
+}
