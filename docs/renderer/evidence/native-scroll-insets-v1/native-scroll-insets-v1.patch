+            options.inline = options.block;
+        }
+        "logical-rtl" => {
+            target.set_direction(Direction::Rtl)?;
+            target.set_scroll_margin_inline_start(LengthValue::px(13.0))?;
+            target.set_scroll_margin_block_end(LengthValue::px(7.0))?;
+            outer.set_scroll_padding_inline_end(LengthValue::px(11.0))?;
+            inner.set_scroll_padding_block_end(LengthValue::px(9.0))?;
+        }
+        "logical-reorder" | "writing-mode-change" => {
+            target.set_scroll_margin_inline_start(LengthValue::px(17.0))?;
+            target.set_scroll_margin_left(LengthValue::px(7.0))?;
+            // Repeating an authored value after an alias must restore priority.
+            target.set_scroll_margin_inline_start(LengthValue::px(17.0))?;
+            outer.set_scroll_padding_block_end(LengthValue::px(11.0))?;
+            outer.set_scroll_padding_bottom(LengthValue::px(5.0))?;
+            outer.set_scroll_padding_block_end(LengthValue::px(11.0))?;
+            if case == "writing-mode-change" {
+                target.set_writing_mode(WritingMode::VerticalRl)?;
+                target.set_direction(Direction::Rtl)?;
+            }
+        }
+        "relative-font" => {
+            target.set_scroll_margin_bottom(LengthValue::Em(0.5))?;
+            target.set_font_size(LengthValue::px(20.0))?;
+            outer.set_scroll_padding_bottom(LengthValue::Rem(0.25))?;
+            document.body().set_font_size(LengthValue::px(24.0))?;
+        }
+        "relative-viewport" => {
+            target.set_scroll_margin_bottom(LengthValue::ViewportHeight(2.5))?;
+            outer.set_scroll_padding_right(LengthValue::ViewportWidth(2.5))?;
