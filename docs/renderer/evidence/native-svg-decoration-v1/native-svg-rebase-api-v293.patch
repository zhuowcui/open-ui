+        let (top, right, bottom, left) = match side {
+            0 => (inset, 0.0, 0.0, 0.0),
+            1 => (0.0, inset, 0.0, 0.0),
+            2 => (0.0, 0.0, inset, 0.0),
+            _ => (0.0, 0.0, 0.0, inset),
+        };
+        let inner = Rect::from_xywh(
+            rect.left + left,
+            rect.top + top,
+            (rect.width() - left - right).max(0.0),
+            (rect.height() - top - bottom).max(0.0),
