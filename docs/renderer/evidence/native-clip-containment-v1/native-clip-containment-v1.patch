+            (area.client_rect.x() - area.content_rect.x())
+                .to_f32()
+                .floor()
+                != 0.0
+                || (area.client_rect.y() - area.content_rect.y())
+                    .to_f32()
+                    .floor()
+                    != 0.0
+        })
 }
 
