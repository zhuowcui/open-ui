+
+#[derive(Clone, Copy)]
+struct RectangularOverflowClip {
+    canvas: usize,
+    transform: Matrix,
+    rect: Rect,
+}
+
+struct RectangularOverflowClipScope(Option<RectangularOverflowClip>);
+
+impl RectangularOverflowClipScope {
+    fn barrier() -> Self {
+        Self(RECTANGULAR_OVERFLOW_CLIP.with(|clip| clip.replace(None)))
+    }
+
+    fn apply(canvas: &Canvas, rect: Rect, antialias: bool, compatible: bool) -> Self {
+        let transform = canvas.local_to_device_as_3x3();
+        let identity = canvas.raw_untracked() as *const skia_safe::Canvas as usize;
+        let previous = RECTANGULAR_OVERFLOW_CLIP.with(|clip| clip.get());
+        let current = (compatible
+            && antialias
+            && rect.is_finite()
+            && !rect.is_empty()
+            && !transform.has_perspective()
+            && transform.rect_stays_rect())
+        .then_some(RectangularOverflowClip {
+            canvas: identity,
+            transform,
+            rect,
+        });
+        // A containing child clip contributes no geometry to the intersection.
+        // Repeating it as a second AA mask instead squares coverage on a shared
+        // fractional edge. Only remove it in the same canvas/transform space;
+        // scroll translations, effects, rounded clips and paths form barriers.
+        let redundant = current.is_some()
+            && previous.is_some_and(|parent| {
+                parent.canvas == identity
+                    && parent.transform == transform
+                    && rect.contains(parent.rect)
+            });
+        if !redundant {
+            canvas.clip_rect(rect, ClipOp::Intersect, antialias);
+        }
+        // A removed clip must keep its containing clip's tighter vector bounds
+        // for subsequent descendants. This scope never widens the native clip.
+        Self(
+            RECTANGULAR_OVERFLOW_CLIP
+                .with(|clip| clip.replace(if redundant { previous } else { current })),
+        )
+    }
+}
+
+impl Drop for RectangularOverflowClipScope {
+    fn drop(&mut self) {
+        RECTANGULAR_OVERFLOW_CLIP.with(|clip| clip.set(self.0));
+    }
+}
