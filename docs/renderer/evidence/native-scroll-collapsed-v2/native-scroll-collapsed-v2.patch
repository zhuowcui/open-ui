diff --git a/bindings/rust/openui/examples/native_scroll_collapsed.rs b/bindings/rust/openui/examples/native_scroll_collapsed.rs
new file mode 100644
index 00000000..0a48b675
--- /dev/null
+++ b/bindings/rust/openui/examples/native_scroll_collapsed.rs
@@ -0,0 +1,153 @@
+//! Native Rust consumer for collapsed-margin scroll queries and mutations.
+use openui::prelude::*;
+
+fn block(
+    document: &Document,
+    parent: &Element,
+    mode: WritingMode,
+    block_size: Option<f32>,
+) -> Result<Element, Error> {
+    let element = Element::create(document, "div")?;
+    if mode == WritingMode::HorizontalTb {
+        element.set_width(LengthValue::px(100.0))?;
+        if let Some(size) = block_size {
+            element.set_height(LengthValue::px(size))?;
+        }
+    } else {
+        element.set_height(LengthValue::px(100.0))?;
+        if let Some(size) = block_size {
+            element.set_width(LengthValue::px(size))?;
+        }
+    }
+    parent.append_child(&element)?;
+    Ok(element)
+}
+
+fn margins(element: &Element, mode: WritingMode, start: f32, end: f32) -> Result<(), Error> {
+    match mode {
+        WritingMode::HorizontalTb => {
+            element.set_margin_top(LengthValue::px(start))?;
+            element.set_margin_bottom(LengthValue::px(end))?;
+        }
+        WritingMode::VerticalRl => {
+            element.set_margin_right(LengthValue::px(start))?;
+            element.set_margin_left(LengthValue::px(end))?;
+        }
+        WritingMode::VerticalLr => {
+            element.set_margin_left(LengthValue::px(start))?;
+            element.set_margin_right(LengthValue::px(end))?;
+        }
+        _ => unreachable!(),
+    }
+    Ok(())
+}
+
+fn snapshot(scroller: &Element, target: &Element, state: &str) -> Result<String, Error> {
+    let metrics = scroller
+        .scroll_metrics()?
+        .expect("connected scroll container");
+    let rect = target.bounding_rect()?.expect("connected target");
+    Ok(format!(
+        "{{\"state\":\"{}\",\"clientWidth\":{},\"clientHeight\":{},\"scrollWidth\":{},\"scrollHeight\":{},\"scrollLeft\":{},\"scrollTop\":{},\"bounds\":{{\"x\":{},\"y\":{},\"width\":{},\"height\":{}}}}}",
+        state, metrics.client_width, metrics.client_height, metrics.scroll_width,
+        metrics.scroll_height, scroller.scroll_left()?, scroller.scroll_top()?,
+        rect.x, rect.y, rect.width, rect.height,
+    ))
+}
+
+fn main() -> Result<(), Box<dyn std::error::Error>> {
+    let mut args = std::env::args().skip(1);
+    let scale: f64 = args.next().ok_or("display scale required")?.parse()?;
+    let structure = args
+        .next()
+        .ok_or("leaf, nested, empty or nested-empty required")?;
+    let mode = match args.next().as_deref().unwrap_or("horizontal-tb") {
+        "horizontal-tb" => WritingMode::HorizontalTb,
+        "vertical-rl" => WritingMode::VerticalRl,
+        "vertical-lr" => WritingMode::VerticalLr,
+        _ => return Err("unsupported writing mode".into()),
+    };
+    let empty = matches!(
+        structure.as_str(),
+        "empty" | "nested-empty" | "first-empty" | "nested-first-empty"
+    );
+    if !matches!(
+        structure.as_str(),
+        "leaf" | "nested" | "empty" | "nested-empty" | "first-empty" | "nested-first-empty"
+    ) {
+        return Err("unsupported structure".into());
+    }
+    let start: f32 = args
+        .next()
+        .map(|s| s.parse())
+        .transpose()?
+        .unwrap_or(if empty { 20.0 } else { 0.0 });
+    let end: f32 = args
+        .next()
+        .map(|s| s.parse())
+        .transpose()?
+        .unwrap_or(if empty { 30.0 } else { 20.0 });
+    let following: Option<f32> = args.next().map(|s| s.parse()).transpose()?;
+    if args.next().is_some() {
+        return Err("unexpected argument".into());
+    }
+    let document =
+        Document::with_viewport_metrics(ViewportMetrics::from_logical_size(640.0, 480.0, scale)?)?;
+    let root = document.body();
+    root.set_scrollbar_width(ScrollbarWidth::None)?;
+    let scroller = block(&document, &root, mode, Some(100.0))?;
+    scroller.set_writing_mode(mode)?;
+    scroller.set_position(Position::Absolute)?;
+    scroller.set_left(Length::px(20.0))?;
+    scroller.set_top(Length::px(20.0))?;
+    scroller.set_overflow(Overflow::Scroll)?;
+    scroller.set_scrollbar_width(ScrollbarWidth::None)?;
+    let parent = if matches!(
+        structure.as_str(),
+        "nested" | "nested-empty" | "nested-first-empty"
+    ) {
+        block(&document, &scroller, mode, None)?
+    } else {
+        scroller.clone()
+    };
+    let _leading = if matches!(structure.as_str(), "empty" | "nested-empty") {
+        Some(block(&document, &parent, mode, Some(100.0))?)
+    } else {
+        None
+    };
+    let target = block(
+        &document,
+        &parent,
+        mode,
+        Some(if empty { 0.0 } else { 100.0 }),
+    )?;
+    margins(&target, mode, start, end)?;
+    let _following = if let Some(start) = following {
+        let element = block(&document, &parent, mode, Some(100.0))?;
+        margins(&element, mode, start, 0.0)?;
+        Some(element)
+    } else {
+        None
+    };
+    let original = scroller.scroll_metrics()?.ok_or("missing scroll metrics")?;
+    let original_height = original.scroll_height;
+    let initial = snapshot(&scroller, &target, "initial")?;
+    let (x, y) = match mode {
+        WritingMode::HorizontalTb => (0.0, 1000.0),
+        WritingMode::VerticalRl => (-1000.0, 0.0),
+        _ => (1000.0, 0.0),
+    };
+    scroller.scroll_to(x, y)?;
+    let at_end = snapshot(&scroller, &target, "end")?;
+    margins(&target, mode, start, 0.0)?;
+    let shrunk = snapshot(&scroller, &target, "shrink")?;
+    println!(
+        "{{\"states\":[{initial},{at_end},{shrunk}],\"ownedSnapshotHeight\":{}}}",
+        original.scroll_height
+    );
+    assert_eq!(original.scroll_height, original_height);
+    drop((root, scroller, parent, target, _leading, _following));
+    drop(document);
+    assert_eq!(original.scroll_height, original_height);
+    Ok(())
+}
