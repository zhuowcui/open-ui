+    #[test]
+    fn collapsed_end_margins_are_queryable_through_native_scroll_mutations() {
+        for scale in [1.0, 1.25, 1.5, 2.0, 3.0] {
+            for empty in [false, true] {
+                let mut engine =
+                    Engine::new(ViewportMetrics::from_logical_size(640.0, 480.0, scale).unwrap())
+                        .unwrap();
+                let scroller = engine.create_native_element(ElementTag::Div).unwrap();
+                let wrapper = engine.create_native_element(ElementTag::Div).unwrap();
+                let target = engine.create_native_element(ElementTag::Div).unwrap();
+                engine.append_child(engine.root(), scroller).unwrap();
+                engine.append_child(scroller, wrapper).unwrap();
+                engine
+                    .append_child(if empty { scroller } else { wrapper }, target)
+                    .unwrap();
+                for node in [scroller, wrapper, target] {
+                    engine
+                        .set_property(node, StyleProperty::Width, LengthValue::px(100.0).into())
+                        .unwrap();
+                }
+                engine
+                    .set_property(
+                        scroller,
+                        StyleProperty::Height,
+                        LengthValue::px(100.0).into(),
+                    )
+                    .unwrap();
+                engine
+                    .set_property(scroller, StyleProperty::Overflow, Overflow::Scroll.into())
+                    .unwrap();
+                engine
+                    .set_property(
+                        scroller,
+                        StyleProperty::ScrollbarWidth,
+                        StyleValue::Renderer(openui_style::RendererStyleValue::ScrollbarWidth(
+                            openui_style::ScrollbarWidth::None,
+                        )),
+                    )
+                    .unwrap();
+                if empty {
+                    engine
+                        .set_property(
+                            wrapper,
+                            StyleProperty::Height,
+                            LengthValue::px(100.0).into(),
+                        )
+                        .unwrap();
+                    engine
+                        .set_property(
+                            target,
+                            StyleProperty::MarginTop,
+                            LengthValue::px(20.0).into(),
+                        )
+                        .unwrap();
+                }
+                engine
+                    .set_property(
+                        target,
+                        StyleProperty::Height,
+                        LengthValue::px(if empty { 0.0 } else { 100.0 }).into(),
+                    )
+                    .unwrap();
+                engine
+                    .set_property(
+                        target,
+                        StyleProperty::MarginBottom,
+                        LengthValue::px(if empty { 30.0 } else { 20.0 }).into(),
+                    )
+                    .unwrap();
+                let original = engine.scroll_metrics(scroller).unwrap().unwrap();
+                assert_eq!(original.client_height, 100.0);
+                assert_eq!(original.scroll_height, if empty { 130.0 } else { 120.0 });
+                let scroller_y = engine.bounds(scroller).unwrap().unwrap().y;
+                let initial_y = engine.bounds(target).unwrap().unwrap().y;
+                assert_eq!(initial_y - scroller_y, if empty { 120.0 } else { 0.0 });
+                engine.scroll_to(scroller, 0.0, 1000.0).unwrap();
+                assert_eq!(
+                    engine.scroll_offset(scroller).unwrap(),
+                    (0.0, if empty { 30.0 } else { 20.0 })
+                );
+                assert_eq!(
+                    engine.bounds(target).unwrap().unwrap().y - scroller_y,
+                    if empty { 90.0 } else { -20.0 }
+                );
+                engine
+                    .set_property(
+                        target,
+                        StyleProperty::MarginBottom,
+                        LengthValue::px(0.0).into(),
+                    )
+                    .unwrap();
+                let shrunk = engine.scroll_metrics(scroller).unwrap().unwrap();
+                assert_eq!(shrunk.scroll_height, if empty { 120.0 } else { 100.0 });
+                assert_eq!(
+                    engine.scroll_offset(scroller).unwrap(),
+                    (0.0, if empty { 20.0 } else { 0.0 })
+                );
+                assert_eq!(original.scroll_height, if empty { 130.0 } else { 120.0 });
+                engine.scroll_to(scroller, 0.0, 0.0).unwrap();
+                if empty {
+                    let following = engine.create_native_element(ElementTag::Div).unwrap();
+                    engine.append_child(scroller, following).unwrap();
+                    engine
+                        .set_property(
+                            following,
+                            StyleProperty::Height,
+                            LengthValue::px(100.0).into(),
+                        )
+                        .unwrap();
+                    engine
+                        .set_property(
+                            following,
+                            StyleProperty::MarginTop,
+                            LengthValue::px(50.0).into(),
+                        )
+                        .unwrap();
+                    // A following sibling's larger margin determines its own
+                    // edge, without moving the empty predecessor's border.
+                    assert_eq!(engine.bounds(target).unwrap().unwrap().y, initial_y);
+                    assert_eq!(
+                        engine.bounds(following).unwrap().unwrap().y - scroller_y,
+                        150.0
+                    );
+                }
+            }
+        }
+    }
+
