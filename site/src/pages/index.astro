---
import { Code } from 'astro:components';
import '../styles/fonts.css';
import '../styles/theme.css';
import Shot from '../components/Shot.astro';
import Icon from '../components/Icon.astro';
import Compare from '../components/Compare.astro';
import CopyCommand from '../components/CopyCommand.astro';
import exampleSource from '../../showcase/src/example.rs?raw';
import { base, nav, repo, install } from '../lib/site';

const title = 'Open UI: native desktop apps in Rust, styled with CSS';
const description =
  'Build native desktop apps in Rust with markup and the CSS you already know. No webview, no JavaScript, one binary. An alpha for Windows and Linux.';

const features = [
  {
    icon: 'palette',
    title: 'Styled with CSS',
    body: "CSS properties and values, checked when you compile. Flexbox, grid, borders and web fonts follow the browser's rules and are tested against Chromium.",
  },
  {
    icon: 'app-window',
    title: 'Native, no webview',
    body: 'Open UI lays out and paints your views itself, with Skia. You ship one executable, not a browser.',
  },
  {
    icon: 'package-check',
    title: 'Batteries included',
    body: 'Windows, menus, file dialogs, clipboard, HTTP and async tasks are part of the framework.',
  },
  {
    icon: 'flask-conical',
    title: 'Testable by default',
    body: 'Mount views headless, click and type like a user, and compare frames with pixel snapshots.',
  },
  {
    icon: 'terminal',
    title: 'One CLI',
    body: 'openui new, dev and build: start an app, rebuild on save, and package a release.',
  },
  {
    icon: 'monitor',
    title: 'Windows and Linux',
    body: 'Both are supported on main, for the first alpha now in progress. macOS is planned.',
  },
];

// `library` tiles show components from openui-components; `example` tiles
// are small apps built from elements plus those components.
const tiles = [
  { name: 'notifications', kind: 'example', caption: 'Example: elements and Button', alt: 'An example built from elements: a notifications panel with two messages and a Mark all as read button' },
  { name: 'buttons', kind: 'library', caption: 'Library: Button', alt: 'The Button component in the default, secondary, outline, ghost, destructive and link styles' },
  { name: 'team', kind: 'example', caption: 'Example: elements and Button', alt: 'An example built from elements: a team list with initials, names, roles and an Invite people button' },
  { name: 'badges', kind: 'library', caption: 'Library: Badge', alt: 'The Badge component in the default, secondary, outline, destructive, ghost and link styles' },
  { name: 'stat', kind: 'example', caption: 'Example: elements only', alt: 'An example built from elements: a monthly revenue figure with a bar' },
  { name: 'settings', kind: 'library', caption: 'Library: Label and Separator', alt: 'The Label and Separator components: a label and description above horizontal and vertical separators' },
];
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <script is:inline>
      // The same setting as the docs (Starlight's theme select).
      (() => {
        let stored = '';
        try {
          stored = localStorage.getItem('starlight-theme') || '';
        } catch {}
        const theme =
          stored === 'light' || stored === 'dark'
            ? stored
            : matchMedia('(prefers-color-scheme: light)').matches
              ? 'light'
              : 'dark';
        document.documentElement.dataset.theme = theme;
      })();
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="nav">
      <div class="container nav-inner">
        <a class="brand" href={base} aria-label="Open UI home">
          <img src={`${base}favicon.svg`} alt="" width="22" height="22" />
          <span>Open UI</span>
          <span class="alpha">alpha</span>
        </a>
        <nav class="nav-links" aria-label="Site">
          {nav.map((item) => <a class="nav-link" href={item.href}>{item.label}</a>)}
          <a class="nav-icon" href={repo} aria-label="GitHub">
            <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path fill="currentColor" d="M12 .3a12 12 0 0 0-3.8 23.4c.6.1.8-.3.8-.6v-2c-3.3.7-4-1.6-4-1.6-.6-1.4-1.4-1.8-1.4-1.8-1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.8 1.3 3.5 1 0-.8.4-1.3.7-1.6-2.7-.3-5.5-1.3-5.5-6 0-1.2.5-2.3 1.3-3.1-.2-.4-.6-1.6 0-3.2 0 0 1-.3 3.4 1.2a11.5 11.5 0 0 1 6 0C17.3 4.6 18.3 5 18.3 5c.7 1.6.2 2.8.1 3.2.8.8 1.3 1.9 1.3 3.1 0 4.6-2.8 5.6-5.5 5.9.5.4.9 1.1.9 2.2v3.3c0 .3.1.7.8.6A12 12 0 0 0 12 .3"/></svg>
          </a>
          <button class="nav-icon theme-toggle" type="button" aria-label="Switch to light theme">
            <Icon name="sun" size={18} class="when-dark" />
            <Icon name="moon" size={18} class="when-light" />
          </button>
        </nav>
      </div>
    </header>

    <main id="main">
      <!-- Hero -->
      <section class="hero">
        <div class="container hero-copy">
          <a class="pill" href={`${base}docs/roadmap/`}>
            <span class="pill-dot" aria-hidden="true"></span>
            alpha.1 in progress · Windows and Linux
            <Icon name="arrow-right" size={14} />
          </a>
          <h1>Native desktop apps in Rust, styled like the web.</h1>
          <p class="lede">
            Write your interface with markup and the CSS you already know. Open UI lays it out and paints
            it by the browser's rules, then ships it as one native binary. No webview, no JavaScript.
          </p>
          <div class="actions">
            <a class="button primary" href={`${base}docs/getting-started/`}>Get started</a>
            <a class="button secondary" href={repo}>View on GitHub</a>
          </div>
          <CopyCommand command={install} />
        </div>
        <div class="container hero-shot">
          <figure class="window">
            <div class="titlebar" aria-hidden="true">
              <span class="titlebar-title">Acme · Overview</span>
              <span class="titlebar-controls"><i class="min"></i><i class="max"></i><i class="close"></i></span>
            </div>
            <Shot
              name="app"
              alt="An example dashboard app built from elements: a sidebar, three stat cards, a list of recent deployments with status badges, and a team list"
              loading="eager"
            />
          </figure>
          <p class="shot-note">
            An example app built from Open UI's elements, with Button and Badge from the component library.
            Rendered by Open UI, like every app image on this site.
          </p>
        </div>
      </section>

      <!-- Code and result -->
      <section class="section">
        <div class="container">
          <p class="eyebrow">Write it</p>
          <h2>Markup and CSS, compiled to a native app</h2>
          <p class="section-lede">
            Views are Rust functions that build Open UI's native elements: <code>div</code>, <code>span</code>,
            <code>button</code>, <code>input</code> and the rest. Styles are CSS, checked when you build.
          </p>
          <div class="split">
            <div class="code-pane">
              <div class="pane-bar"><span>src/deploy_card.rs</span></div>
              <Code code={exampleSource.trimEnd()} lang="rust" themes={{ light: 'github-light', dark: 'github-dark' }} defaultColor={false} />
            </div>
            <div class="result-pane">
              <div class="pane-bar"><span>Result</span></div>
              <div class="result-stage">
                <Shot name="example" alt="A card titled Production with a Live badge, a line of text and two buttons, Redeploy and View logs" />
              </div>
              <p class="pane-note">Drawn by Open UI from the code on the left.</p>
            </div>
          </div>
          <a class="more" href={`${base}elements/`}>Browse the elements <Icon name="arrow-right" size={16} /></a>
        </div>
      </section>

      <!-- Features -->
      <section class="section band">
        <div class="container">
          <p class="eyebrow">What you get</p>
          <h2>Everything an app needs, in one framework</h2>
          <div class="features">
            {
              features.map((feature) => (
                <div class="feature">
                  <span class="feature-icon">
                    <Icon name={feature.icon} size={20} />
                  </span>
                  <h3>{feature.title}</h3>
                  <p>{feature.body}</p>
                </div>
              ))
            }
          </div>
        </div>
      </section>

      <!-- Components -->
      <section class="section">
        <div class="container">
          <p class="eyebrow">Components</p>
          <h2>A component library, in progress</h2>
          <p class="section-lede">
            A library based on shadcn/ui designs, built on the elements: button, badge, card, label and
            separator so far. The tiles marked Example are small apps made from elements and those
            components.
          </p>
          <div class="gallery">
            {
              tiles.map((tile) => (
                <figure class="tile">
                  <Shot name={tile.name} alt={tile.alt} />
                  <figcaption class={`tile-tag ${tile.kind}`}>{tile.caption}</figcaption>
                </figure>
              ))
            }
          </div>
          <a class="more" href={`${base}components/`}>Browse components <Icon name="arrow-right" size={16} /></a>
        </div>
      </section>

      <!-- Fidelity -->
      <section class="section band">
        <div class="container fidelity">
          <div class="fidelity-copy">
            <p class="eyebrow">Fidelity</p>
            <h2>Looks like the web</h2>
            <p>
              The card from the example, drawn by Chrome from HTML and by Open UI from Rust. Drag to
              compare: boxes, borders and colors match, and text can still land a pixel off.
            </p>
            <a class="more" href={`${base}docs/rendering/`}>How rendering is checked <Icon name="arrow-right" size={16} /></a>
          </div>
          <Compare />
        </div>
      </section>

      <!-- Call to action -->
      <section class="section cta">
        <div class="container cta-inner">
          <h2>Build your first app</h2>
          <p class="section-lede">Install the CLI, run <code>openui new my-app</code>, and you have a window in minutes.</p>
          <div class="actions">
            <a class="button primary" href={`${base}docs/getting-started/`}>Get started</a>
            <a class="button secondary" href={`${base}docs/`}>Read the docs</a>
          </div>
        </div>
      </section>
    </main>

    <footer class="footer">
      <div class="container footer-inner">
        <div class="footer-brand">
          <a class="brand" href={base}>
            <img src={`${base}favicon.svg`} alt="" width="20" height="20" />
            <span>Open UI</span>
          </a>
          <p>An experimental alpha. Apache-2.0.</p>
        </div>
        <div class="footer-cols">
          <div>
            <h4>Learn</h4>
            <a href={`${base}docs/getting-started/`}>Getting started</a>
            <a href={`${base}docs/`}>Docs</a>
            <a href={`${base}components/`}>Components</a>
          </div>
          <div>
            <h4>Project</h4>
            <a href={`${base}docs/roadmap/`}>Roadmap</a>
            <a href={`${base}blog/`}>Blog</a>
            <a href={repo}>GitHub</a>
          </div>
          <div>
            <h4>About</h4>
            <a href={`${base}docs/about/`}>About this site</a>
            <a href={`${base}docs/rendering/`}>Rendering</a>
          </div>
        </div>
      </div>
      <div class="container fine">
        “Open UI” is a working name; the project is unrelated to the W3C Open UI Community Group. This
        site is HTML; the app images on it are rendered by Open UI.
      </div>
    </footer>

    <script>
      const toggle = document.querySelector<HTMLButtonElement>('.theme-toggle');
      const label = () => {
        const dark = document.documentElement.dataset.theme !== 'light';
        toggle?.setAttribute('aria-label', dark ? 'Switch to light theme' : 'Switch to dark theme');
      };
      label();
      toggle?.addEventListener('click', () => {
        const next = document.documentElement.dataset.theme === 'light' ? 'dark' : 'light';
        document.documentElement.dataset.theme = next;
        try {
          localStorage.setItem('starlight-theme', next);
        } catch {}
        label();
      });
    </script>
  </body>
</html>

<style is:global>
  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }
  html {
    -webkit-text-size-adjust: 100%;
  }
  body {
    margin: 0;
    background: var(--ou-bg);
    color: var(--ou-text);
    font-family: var(--sl-font);
    font-size: 16px;
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
  }
  img {
    max-width: 100%;
    height: auto;
    display: block;
  }
  a {
    color: inherit;
  }
  :focus-visible {
    outline: 2px solid var(--ou-accent);
    outline-offset: 2px;
  }
  /* Shiki with CSS-variable colors, switched by the site theme. */
  .astro-code,
  .astro-code span {
    color: var(--shiki-light);
    background-color: var(--shiki-light-bg);
  }
  :root:not([data-theme='light']) .astro-code,
  :root:not([data-theme='light']) .astro-code span {
    color: var(--shiki-dark);
    background-color: var(--shiki-dark-bg);
  }
  :root[data-theme='light'] .when-light,
  :root:not([data-theme='light']) .when-dark {
    display: none;
  }
</style>

<style>
  .container {
    width: 100%;
    max-width: 1152px;
    margin: 0 auto;
    padding: 0 24px;
  }
  .skip {
    position: absolute;
    left: -9999px;
  }
  .skip:focus {
    left: 16px;
    top: 12px;
    z-index: 100;
    background: var(--ou-surface);
    padding: 8px 12px;
    border-radius: 8px;
  }

  /* Header */
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid var(--ou-border);
    background: color-mix(in srgb, var(--ou-bg) 80%, transparent);
    backdrop-filter: blur(12px);
  }
  .nav-inner {
    height: 60px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }
  .brand {
    white-space: nowrap;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-weight: 600;
    text-decoration: none;
    letter-spacing: -0.01em;
  }
  .alpha {
    font-family: var(--sl-font-mono);
    font-size: 11px;
    font-weight: 500;
    line-height: 1;
    padding: 4px 6px;
    border-radius: 999px;
    border: 1px solid var(--ou-border-strong);
    color: var(--ou-muted);
  }
  .nav-links {
    display: flex;
    align-items: center;
    gap: 4px;
  }
  .nav-link {
    font-size: 14px;
    color: var(--ou-muted);
    text-decoration: none;
    padding: 6px 10px;
    border-radius: 8px;
  }
  .nav-link:hover {
    color: var(--ou-text);
  }
  .nav-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 8px;
    color: var(--ou-muted);
    background: none;
    border: 0;
    cursor: pointer;
  }
  .nav-icon:hover {
    color: var(--ou-text);
    background: var(--ou-accent-soft);
  }

  /* Hero */
  .hero {
    padding: clamp(56px, 9vw, 104px) 0 clamp(56px, 8vw, 96px);
    position: relative;
    overflow: hidden;
  }
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(var(--ou-border) 1px, transparent 1px),
      linear-gradient(90deg, var(--ou-border) 1px, transparent 1px);
    background-size: 32px 32px;
    mask-image: radial-gradient(ellipse 70% 50% at 50% 0%, #000 30%, transparent 75%);
    opacity: 0.5;
    pointer-events: none;
  }
  .hero-copy {
    position: relative;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    color: var(--ou-muted);
    text-decoration: none;
    padding: 4px 12px;
    border: 1px solid var(--ou-border);
    border-radius: 999px;
    background: var(--ou-bg);
  }
  .pill:hover {
    color: var(--ou-text);
    border-color: var(--ou-border-strong);
  }
  .pill-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--ou-accent);
  }
  h1 {
    margin: 24px 0 0;
    max-width: 18ch;
    font-size: clamp(40px, 6.4vw, 68px);
    line-height: 1.04;
    font-weight: 650;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }
  .lede {
    margin: 20px 0 0;
    max-width: 620px;
    font-size: clamp(17px, 2vw, 19px);
    line-height: 1.55;
    color: var(--ou-muted);
    text-wrap: pretty;
  }
  .actions {
    margin-top: 32px;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
  }
  .button {
    display: inline-flex;
    align-items: center;
    height: 42px;
    padding: 0 20px;
    border-radius: 10px;
    font-size: 15px;
    font-weight: 500;
    text-decoration: none;
    border: 1px solid transparent;
    transition: background-color 0.15s, border-color 0.15s;
  }
  .button.primary {
    background: var(--ou-button);
    color: var(--ou-button-text);
  }
  .button.primary:hover {
    opacity: 0.9;
  }
  .button.secondary {
    border-color: var(--ou-border-strong);
    background: var(--ou-bg);
  }
  .button.secondary:hover {
    background: var(--ou-accent-soft);
  }
  .hero-shot {
    position: relative;
    margin-top: clamp(48px, 7vw, 72px);
  }
  .hero-shot::before {
    content: '';
    position: absolute;
    inset: 10% 8% -4% 8%;
    background: radial-gradient(closest-side, var(--ou-glow), transparent);
    filter: blur(40px);
    pointer-events: none;
  }
  .window {
    position: relative;
    margin: 0;
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid var(--ou-border);
    box-shadow: var(--ou-shadow);
    background: var(--ou-surface);
  }
  .titlebar {
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 0 0 14px;
    border-bottom: 1px solid var(--ou-border);
    background: var(--ou-bg-soft);
    font-size: 12px;
    color: var(--ou-muted);
  }
  .titlebar-controls {
    display: flex;
    height: 100%;
  }
  .titlebar-controls i {
    width: 44px;
    height: 100%;
    position: relative;
  }
  .titlebar-controls i::before,
  .titlebar-controls i::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
    border-color: var(--ou-muted);
  }
  .min::before {
    width: 10px;
    border-top: 1px solid;
    transform: translate(-50%, 0);
  }
  .max::before {
    width: 9px;
    height: 9px;
    border: 1px solid;
    transform: translate(-50%, -50%);
  }
  .close::before,
  .close::after {
    width: 12px;
    border-top: 1px solid;
    transform: translate(-50%, 0) rotate(45deg);
  }
  .close::after {
    transform: translate(-50%, 0) rotate(-45deg);
  }
  .shot-note {
    position: relative;
    margin: 16px 0 0;
    text-align: center;
    font-size: 13px;
    color: var(--ou-muted);
  }

  /* Sections */
  .section {
    padding: clamp(64px, 9vw, 112px) 0;
    border-top: 1px solid var(--ou-border);
  }
  .band {
    background: var(--ou-bg-soft);
  }
  .eyebrow {
    margin: 0;
    font-family: var(--sl-font-mono);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ou-accent);
  }
  h2 {
    margin: 12px 0 0;
    max-width: 20ch;
    font-size: clamp(28px, 4vw, 40px);
    line-height: 1.12;
    font-weight: 650;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }
  .section-lede {
    margin: 16px 0 0;
    max-width: 600px;
    font-size: 17px;
    color: var(--ou-muted);
  }
  .section-lede code {
    font-family: var(--sl-font-mono);
    font-size: 0.9em;
    color: var(--ou-text);
  }

  /* Code and result */
  .split {
    margin-top: 40px;
    display: grid;
    grid-template-columns: minmax(0, 1.65fr) minmax(0, 1fr);
    gap: 16px;
    align-items: start;
  }
  .code-pane,
  .result-pane {
    border: 1px solid var(--ou-border);
    border-radius: 14px;
    overflow: hidden;
    background: var(--ou-surface);
    display: flex;
    flex-direction: column;
  }
  .pane-bar {
    height: 40px;
    display: flex;
    align-items: center;
    padding: 0 16px;
    border-bottom: 1px solid var(--ou-border);
    font-family: var(--sl-font-mono);
    font-size: 12px;
    color: var(--ou-muted);
    background: var(--ou-bg-soft);
  }
  .code-pane :global(pre) {
    margin: 0;
    padding: 18px 20px;
    font-family: var(--sl-font-mono);
    font-size: 12.5px;
    line-height: 1.6;
    overflow-x: auto;
    flex: 1;
  }
  .code-pane :global(pre),
  .code-pane :global(pre span) {
    background-color: transparent !important;
  }
  .result-pane {
    position: sticky;
    top: 84px;
  }
  .result-stage {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px 16px;
    background: #ffffff;
  }

  .pane-note {
    margin: 0;
    padding: 12px 16px;
    border-top: 1px solid var(--ou-border);
    font-size: 13px;
    color: var(--ou-muted);
  }

  /* Features */
  .features {
    margin-top: 40px;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }
  .feature {
    padding: 24px;
    border: 1px solid var(--ou-border);
    border-radius: 14px;
    background: var(--ou-surface);
  }
  .feature-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: 10px;
    background: var(--ou-accent-soft);
    color: var(--ou-accent);
  }
  .feature h3 {
    margin: 18px 0 0;
    font-size: 16px;
    font-weight: 600;
    letter-spacing: -0.01em;
  }
