---
// A Lucide icon (lucide-static, ISC), inlined so it takes the text color.
interface Props {
  name: string;
  size?: number;
  class?: string;
}
const { name, size = 20, class: className } = Astro.props;
const icons = import.meta.glob<string>('../../node_modules/lucide-static/icons/*.svg', {
  query: '?raw',
  import: 'default',
  eager: true,
});
const raw = icons[`../../node_modules/lucide-static/icons/${name}.svg`];
if (!raw) throw new Error(`no Lucide icon ${name}`);
const svg = raw
  .replace(/<!--[\s\S]*?-->/, '')
  .replace(/width="24"/, `width="${size}"`)
  .replace(/height="24"/, `height="${size}"`)
  .replace('<svg', `<svg aria-hidden="true" focusable="false"${className ? ` class="${className}"` : ''}`);
---

<Fragment set:html={svg} />
