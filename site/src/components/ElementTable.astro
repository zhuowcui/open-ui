---
// The supported tags, from src/data/elements.json, which
// scripts/gen-reference.mjs generates from the openui and engine source.
import data from '../data/elements.json';

interface Props {
  /** Only these tags; all of them when left out. */
  tags?: string[];
  /** Link each tag to its reference page. */
  links?: boolean;
}
const { tags, links = true } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');

// The reference page that documents each tag.
const pageOf: Record<string, string> = {};
const pages: Record<string, string[]> = {
  div: ['div', 'main', 'nav', 'header', 'footer', 'section', 'article', 'aside', 'p', 'h1', 'h2', 'h3', 'h4', 'h5', 'h6', 'hr'],
  span: ['span', 'a', 'label', 'strong', 'em', 'small'],
  lists: ['ul', 'ol', 'li'],
  br: ['br', 'wbr'],
  ruby: ['ruby', 'rt'],
  table: ['table', 'caption', 'colgroup', 'col', 'thead', 'tbody', 'tfoot', 'tr', 'td', 'th'],
  img: ['img'],
  button: ['button'],
  input: ['input'],
  textarea: ['textarea'],
  select: ['select', 'option', 'optgroup'],
  'meter-progress': ['meter', 'progress'],
  details: ['details', 'summary'],
  fieldset: ['fieldset', 'legend'],
  form: ['form'],
  embedded: ['canvas', 'svg', 'iframe', 'object', 'audio', 'video', 'embed'],
};
for (const [page, list] of Object.entries(pages)) for (const tag of list) pageOf[tag] = page;

const rows = data.elements.filter((row) => !tags || tags.includes(row.tag));
const missing = data.elements.filter((row) => !pageOf[row.tag]).map((row) => row.tag);
if (missing.length) throw new Error(`no reference page for ${missing.join(', ')}`);
---

<table>
  <thead>
    <tr>
      <th>Tag</th>
      <th>Kind</th>
      <th>Default <code>display</code></th>
      <th>Default accessibility role</th>
    </tr>
  </thead>
  <tbody>
    {
      rows.map((row) => (
        <tr>
          <td>
            {links ? (
              <a href={`${base}elements/${pageOf[row.tag]}/`}>
                <code>{`<${row.tag}>`}</code>
              </a>
            ) : (
              <code>{`<${row.tag}>`}</code>
            )}
          </td>
          <td>
            <code>{row.kind}</code>
          </td>
          <td>
            <code>{row.display}</code>
          </td>
          <td>
            <code>{row.role}</code>
            {row.control && row.tag === 'input' ? ' (by type)' : ''}
          </td>
        </tr>
      ))
    }
  </tbody>
</table>
