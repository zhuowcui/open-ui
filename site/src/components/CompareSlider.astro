---
// A Chromium capture and the Open UI render of the same page, revealed by a
// slider, with an optional overlay of the pixels whose RGBA bytes differ.
// The images are committed evidence copied byte for byte by
// scripts/sync-assets.mjs, which also counted the differing pixels. The
// overlay is recomputed here, in the browser, from the same files.
import data from '../assets/generated/comparisons.json';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const repo = 'https://github.com/zhuowcui/open-ui/blob/main/';
const { crop, test, cases } = data;
const total = cases[0].width * cases[0].height;
const fmt = (n: number) => n.toLocaleString('en-US');
const chromiumVersion = test.chromium.split(' ')[0];
---

<figure
  class="cmp"
  data-crop-x={crop.x}
  data-crop-y={crop.y}
  data-crop-w={crop.width}
  data-crop-h={crop.height}
  data-focus-x={crop.focus.x}
  data-focus-y={crop.focus.y}
>
  <div class="cmp-tabs" role="tablist" aria-label="Comparison">
    {
      cases.map((c, i) => (
        <button
          type="button"
          role="tab"
          id={`cmp-tab-${c.id}`}
          aria-controls="cmp-panel"
          aria-selected={i === 0 ? 'true' : 'false'}
          tabindex={i === 0 ? 0 : -1}
          data-case={c.id}
        >
          <span class:list={['cmp-dot', c.diffPixels === 0 ? 'is-exact' : 'is-diff']} aria-hidden="true" />
          {c.label}
        </button>
      ))
    }
  </div>

  <div id="cmp-panel" role="tabpanel" aria-labelledby={`cmp-tab-${cases[0].id}`} class="cmp-panel">
    <div class="cmp-stage" style={`aspect-ratio: ${crop.width} / ${crop.height}`}>
      <div class="cmp-view cmp-chromium">
        <div class="cmp-world">
          <img
            data-role="chromium"
            src={base + cases[0].chromium.src}
            width={cases[0].width}
            height={cases[0].height}
            alt="Chromium capture of fieldsets and legends split across columns, with blue fills."
            decoding="async"
          />
        </div>
      </div>
      <div class="cmp-view cmp-openui">
        <div class="cmp-world">
          <img
            data-role="openui"
            src={base + cases[0].openui.src}
            width={cases[0].width}
            height={cases[0].height}
            alt="Open UI render of the same page."
            decoding="async"
          />
        </div>
      </div>
      <div class="cmp-scrim" aria-hidden="true"></div>
      <div class="cmp-view cmp-diff" hidden>
        <div class="cmp-world">
          <canvas width={cases[0].width} height={cases[0].height} aria-hidden="true"></canvas>
        </div>
        <div class="cmp-marker" aria-hidden="true"></div>
      </div>
      <div class="cmp-split" aria-hidden="true"><span></span></div>
      <span class="cmp-tag cmp-tag-left" aria-hidden="true">Chromium {chromiumVersion}</span>
      <span class="cmp-tag cmp-tag-right" aria-hidden="true">Open UI</span>
      <input
        class="cmp-range"
        type="range"
        min="0"
        max="100"
        step="1"
        value="50"
        aria-label="Split position: Chromium to the left of the line, Open UI to the right"
        aria-valuetext="50% Chromium"
      />
    </div>

    <div class="cmp-controls">
      <button type="button" class="cmp-toggle" data-action="diff" aria-pressed="false">
        <span class="cmp-swatch" aria-hidden="true"></span> Show differing pixels
      </button>
      <button type="button" class="cmp-toggle" data-action="zoom" aria-pressed="false">
        Zoom to real pixels
      </button>
      <p class="cmp-count" aria-live="polite">
        {
          cases.map((c, i) => (
            <span data-count={c.id} hidden={i !== 0}>
              {c.diffPixels === 0 ? (
                <strong class="ou-exact">Exact: 0 of {fmt(total)} pixels differ</strong>
              ) : (
                <strong class="ou-mismatch">
                  {fmt(c.diffPixels)} of {fmt(total)} pixels differ (largest channel difference {c.maxChannelDelta})
                </strong>
              )}
            </span>
          ))
        }
        <span class="cmp-verify" data-verify></span>
      </p>
    </div>

    <figcaption class="cmp-caption">
      {
        cases.map((c, i) => (
          <p data-summary={c.id} hidden={i !== 0}>
            {c.summary} Measured at {c.measured};{' '}
            <a href={repo + c.evidence}>evidence</a>.
          </p>
        ))
      }
      <p class="cmp-source">
        {test.description} Chromium {chromiumVersion}, tolerance 0. Images are committed files, copied unmodified
        and shown cropped to the page's content; see the{' '}
        <a href={repo + test.record}>investigation record</a> and{' '}
        <a href={repo + 'site/scripts/assets.json'}>their hashes</a>.
      </p>
    </figcaption>
  </div>
</figure>

<script define:vars={{ cases, base }}>
  // Plain script with data from the build; see the frontmatter for the source.
  const root = document.querySelector('.cmp');
  if (root) {
    const crop = {
      x: Number(root.dataset.cropX),
      y: Number(root.dataset.cropY),
      w: Number(root.dataset.cropW),
      h: Number(root.dataset.cropH),
    };
    const focus = { x: Number(root.dataset.focusX), y: Number(root.dataset.focusY) };
    const stage = root.querySelector('.cmp-stage');
    const range = root.querySelector('.cmp-range');
    const tabs = [...root.querySelectorAll('[role="tab"]')];
    const panel = root.querySelector('[role="tabpanel"]');
    const chromiumImg = root.querySelector('img[data-role="chromium"]');
    const openuiImg = root.querySelector('img[data-role="openui"]');
    const diffView = root.querySelector('.cmp-diff');
    const canvas = diffView.querySelector('canvas');
    const marker = root.querySelector('.cmp-marker');
    const verify = root.querySelector('[data-verify]');
    const diffButton = root.querySelector('[data-action="diff"]');
    const zoomButton = root.querySelector('[data-action="zoom"]');
    const worlds = [...root.querySelectorAll('.cmp-world')];

    let current = cases[0];
    let zoomed = false;
    let token = 0;

    function setSplit(value) {
      root.style.setProperty('--split', `${value}%`);
      range.setAttribute('aria-valuetext', `${value}% Chromium, ${100 - value}% Open UI`);
    }

    // Lays out the image so the crop fills the stage, or, zoomed, so one
    // image pixel is several CSS pixels around the focus point.
    function layout() {
      const box = stage.getBoundingClientRect();
      if (!box.width) return;
      const fit = box.width / crop.w;
      let scale = fit;
      let ox = -crop.x * fit;
      let oy = -crop.y * fit;
      const f = current.bounds && current.bounds.width * current.bounds.height < 4000
        ? { x: current.bounds.x + current.bounds.width / 2, y: current.bounds.y + current.bounds.height / 2 }
        : focus;
      if (zoomed) {
        scale = Math.max(fit * 4, 8);
        ox = box.width / 2 - f.x * scale;
        oy = box.height / 2 - f.y * scale;
        ox = Math.min(0, Math.max(box.width - current.width * scale, ox));
        oy = Math.min(0, Math.max(box.height - current.height * scale, oy));
      }
      for (const world of worlds) {
        world.style.width = `${current.width}px`;
        world.style.height = `${current.height}px`;
        world.style.transform = `translate(${ox}px, ${oy}px) scale(${scale})`;
      }
      if (current.bounds) {
        const b = current.bounds;
        marker.hidden = false;
        marker.style.left = `${ox + b.x * scale}px`;
        marker.style.top = `${oy + b.y * scale}px`;
        marker.style.width = `${Math.max(b.width * scale, 1)}px`;
        marker.style.height = `${Math.max(b.height * scale, 1)}px`;
      } else {
        marker.hidden = true;
      }
      root.toggleAttribute('data-zoomed', zoomed);
      // Enlarged pixels stay square; reduced images are smoothed so a
      // one-pixel line does not vanish between samples.
      root.toggleAttribute('data-pixelated', scale >= 1);
    }

    async function loadPixels(src) {
      const response = await fetch(src);
      const blob = await response.blob();
      // No color conversion: compare the stored bytes.
      const bitmap = await createImageBitmap(blob, {
        colorSpaceConversion: 'none',
        premultiplyAlpha: 'none',
      });
      const c = new OffscreenCanvas(bitmap.width, bitmap.height);
      const g = c.getContext('2d', { willReadFrequently: true });
      g.drawImage(bitmap, 0, 0);
      return g.getImageData(0, 0, bitmap.width, bitmap.height);
    }

    // Recomputes the differing pixels from the two files and paints them
    // magenta on a transparent canvas. Nothing is enlarged or smoothed.
    async function computeDiff(item) {
      const mine = ++token;
      verify.textContent = '';
      try {
        const [a, b] = await Promise.all([
          loadPixels(base + item.chromium.src),
          loadPixels(base + item.openui.src),
        ]);
        if (mine !== token) return;
        const out = new ImageData(a.width, a.height);
        let count = 0;
        for (let i = 0; i < a.data.length; i += 4) {
          if (
            a.data[i] !== b.data[i] ||
            a.data[i + 1] !== b.data[i + 1] ||
            a.data[i + 2] !== b.data[i + 2] ||
            a.data[i + 3] !== b.data[i + 3]
          ) {
            count++;
            out.data[i] = 255;
            out.data[i + 2] = 255;
            out.data[i + 3] = 255;
          }
        }
        canvas.width = a.width;
        canvas.height = a.height;
        canvas.getContext('2d').putImageData(out, 0, 0);
        verify.textContent =
          count === item.diffPixels
            ? ` Recounted in your browser: ${count.toLocaleString('en-US')}.`
            : ` Your browser decoded these files differently (${count.toLocaleString('en-US')} differing pixels).`;
      } catch {
        verify.textContent = ' The overlay could not be computed in this browser.';
      }
    }

    function select(id, focusTab) {
      const item = cases.find((c) => c.id === id);
      if (!item) return;
      current = item;
      for (const tab of tabs) {
        const on = tab.dataset.case === id;
        tab.setAttribute('aria-selected', String(on));
        tab.tabIndex = on ? 0 : -1;
        if (on) {
          panel.setAttribute('aria-labelledby', tab.id);
          if (focusTab) tab.focus();
        }
      }
      chromiumImg.src = base + item.chromium.src;
      openuiImg.src = base + item.openui.src;
      for (const el of root.querySelectorAll('[data-count]')) el.hidden = el.dataset.count !== id;
      for (const el of root.querySelectorAll('[data-summary]')) el.hidden = el.dataset.summary !== id;
      root.dataset.exact = String(item.diffPixels === 0);
      layout();
      computeDiff(item);
    }

    range.addEventListener('input', () => setSplit(Number(range.value)));

    for (const tab of tabs) {
      tab.addEventListener('click', () => select(tab.dataset.case, false));
      tab.addEventListener('keydown', (event) => {
        const i = tabs.indexOf(tab);
        let next = null;
        if (event.key === 'ArrowRight') next = tabs[(i + 1) % tabs.length];
        else if (event.key === 'ArrowLeft') next = tabs[(i - 1 + tabs.length) % tabs.length];
        else if (event.key === 'Home') next = tabs[0];
        else if (event.key === 'End') next = tabs[tabs.length - 1];
        if (next) {
          event.preventDefault();
          select(next.dataset.case, true);
        }
      });
    }

    diffButton.addEventListener('click', () => {
      const on = diffButton.getAttribute('aria-pressed') !== 'true';
      diffButton.setAttribute('aria-pressed', String(on));
      diffView.hidden = !on;
      root.toggleAttribute('data-diff', on);
    });

    zoomButton.addEventListener('click', () => {
      zoomed = zoomButton.getAttribute('aria-pressed') !== 'true';
      zoomButton.setAttribute('aria-pressed', String(zoomed));
      layout();
    });

    new ResizeObserver(layout).observe(stage);
    setSplit(50);
    select(cases[0].id, false);
  }
</script>

<style>
  .cmp {
    --split: 50%;
    max-width: 752px;
    margin: 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.75rem;
  }

  .cmp-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
    padding: 0.25rem;
    border: 1px solid var(--ou-border);
    border-radius: 0.5rem;
    width: fit-content;
    max-width: 100%;
  }

  .cmp-tabs button {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font: inherit;
    font-size: 0.875rem;
    line-height: 1.25rem;
    padding: 0.375rem 0.75rem;
    border: 0;
    border-radius: 0.375rem;
    background: transparent;
    color: var(--ou-muted);
    cursor: pointer;
  }

  .cmp-tabs button[aria-selected='true'] {
    background: var(--sl-color-gray-6);
    color: var(--sl-color-white);
  }

  .cmp-dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 1px;
  }

  .cmp-dot.is-exact {
    background: var(--ou-exact);
  }

  .cmp-dot.is-diff {
    background: var(--ou-mismatch);
  }

  .cmp-panel {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.75rem;
  }

  .cmp-stage {
    position: relative;
    overflow: hidden;
    border: 1px solid var(--ou-border);
    border-radius: 0.5rem;
    background: #fff;
    touch-action: pan-y;
  }

  .cmp-view {
    position: absolute;
    inset: 0;
  }

  .cmp-openui {
    clip-path: inset(0 0 0 var(--split));
  }

  .cmp-world {
    position: absolute;
    left: 0;
    top: 0;
    transform-origin: 0 0;
  }

  .cmp-world img,
  .cmp-world canvas {
    display: block;
    width: 100%;
    height: 100%;
    max-width: none;
  }

  /* Real pixels, enlarged without smoothing. */
  .cmp[data-pixelated] .cmp-world img,
  .cmp[data-pixelated] .cmp-world canvas {
    image-rendering: pixelated;
  }

  /* With the overlay on, the images fade to gray behind the magenta. */
  .cmp[data-diff] .cmp-chromium,
  .cmp[data-diff] .cmp-openui {
    filter: grayscale(1);
  }

  .cmp-scrim {
    position: absolute;
    inset: 0;
    background: rgb(255 255 255 / 0.7);
    display: none;
    pointer-events: none;
  }

  .cmp[data-diff] .cmp-scrim {
    display: block;
  }

  .cmp-marker {
    position: absolute;
    outline: 1px dashed var(--ou-mismatch-solid);
    outline-offset: 3px;
    pointer-events: none;
  }

  .cmp-split {
    position: absolute;
    top: 0;
    bottom: 0;
    left: var(--split);
    width: 0;
    pointer-events: none;
  }

  .cmp-split::before {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    left: -0.5px;
    border-left: 1px solid #09090b;
  }

  /* A crosshair on the split line. */
  .cmp-split span {
    position: absolute;
    top: 50%;
    left: -12px;
    width: 24px;
    height: 24px;
    margin-top: -12px;
    border: 1px solid #09090b;
    border-radius: 2px;
    background:
      linear-gradient(#09090b, #09090b) center / 1px 100% no-repeat,
      linear-gradient(#09090b, #09090b) center / 100% 1px no-repeat,
      #fff;
  }

  .cmp-tag {
    position: absolute;
    top: 0.5rem;
    padding: 0.125rem 0.375rem;
    border-radius: 0.25rem;
    background: rgb(9 9 11 / 0.85);
    color: #fafafa;
    font-family: var(--__sl-font-mono);
    font-size: 0.75rem;
    line-height: 1rem;
    pointer-events: none;
  }

  .cmp-tag-left {
    left: 0.5rem;
  }

  .cmp-tag-right {
    right: 0.5rem;
  }

  .cmp-range {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    opacity: 0;
    cursor: ew-resize;
    -webkit-appearance: none;
    appearance: none;
    background: transparent;
  }

  .cmp-range::-webkit-slider-thumb {
    -webkit-appearance: none;
    width: 2.75rem;
    height: 100vh;
  }

  .cmp-range::-moz-range-thumb {
    width: 2.75rem;
    height: 100vh;
    border: 0;
  }

  .cmp-stage:has(.cmp-range:focus-visible) {
    outline: 2px solid var(--sl-color-white);
    outline-offset: 2px;
  }

  .cmp-controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.75rem;
  }

  .cmp-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font: inherit;
    font-size: 0.875rem;
    line-height: 1.25rem;
    padding: 0.375rem 0.75rem;
    border: 1px solid var(--ou-border);
    border-radius: 0.375rem;
    background: transparent;
    color: var(--sl-color-white);
    cursor: pointer;
  }

  .cmp-toggle[aria-pressed='true'] {
    background: var(--sl-color-gray-6);
    border-color: var(--sl-color-gray-4);
  }

  .cmp-tabs button:focus-visible,
  .cmp-toggle:focus-visible {
    outline: 2px solid var(--sl-color-white);
    outline-offset: 2px;
  }

  .cmp-swatch {
    width: 0.625rem;
    height: 0.625rem;
    background: var(--ou-mismatch-solid);
  }

  .cmp-count {
    margin: 0;
    font-size: 0.875rem;
    font-variant-numeric: tabular-nums;
  }

  .cmp-verify {
    color: var(--ou-muted);
  }

  .cmp-caption {
    font-size: 0.8125rem;
    line-height: 1.25rem;
    color: var(--ou-muted);
  }

  .cmp-caption p {
    margin: 0 0 0.375rem;
  }

  .cmp-caption a {
    color: inherit;
  }
</style>
